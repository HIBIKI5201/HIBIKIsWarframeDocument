  {"path": [], "idle": false, "lines": [["Flare and Lizzie's voice lines and sound effects.", null]]},
  {"path": ["In Höllvania Central Mall", "Introduction"], "idle": false, "lines": [["- Flare: \"So a time traveller and a rock-n-roll mutant walk into a bar. And the mutant says 'hey, my friends all got executed, can we go back and save them?' But the time traveller says 'well, if we save them then you never go on the run and hide out at the mall, so we never meet and they can never get saved.' So it goes, right? Anyways, I'm Flare. Good to meet you, Drifter.\"", "DFirstVisit0100Flare_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "On Approach"], "idle": false, "lines": [["- Flare: \"These are my people. My beautiful freaks.\"", "DIdleBarks0010Flare_en.ogg"], ["- Flare: \"You gotta live, if only to piss off all the people who wanna see you dead.\"", "DIdleBarks0020Flare_en.ogg"], ["- Flare: \"I'm done running.\"", "DIdleBarks0030Flare_en.ogg"], ["- Flare: \"You wanna help us stick it to the man?\"", "DIdleBarks0040Flare_en.ogg"], ["- Flare: \"This is where you get to find out what people really stand for.\"", "DIdleBarks0050Flare_en.ogg"], ["- Lizzie: \"The demon is abroad.\"", "DIdleBarks0060Lizzie_en.ogg"], ["- Lizzie: \"My sweet Flare!\"", "DIdleBarks0070Lizzie_en.ogg"], ["- Lizzie: \"Call them up for the last dance!\"", "DIdleBarks0080Lizzie_en.ogg"], ["- Lizzie: \"After the plague, the burning.\"", "DIdleBarks0090Lizzie_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Greetings", "Normal"], "idle": false, "lines": [["- Flare: \"Still not dead or crazy. How 'bout you?\"", "DGrtingNoScrtEnd0110Flare_en.ogg"], ["- Flare: \"Yo, Drifter!\"", "DGrtingNoScrtEnd0120Flare_en.ogg"], ["- Flare: \"Lizzie, play nice.\"", "DGrtingNoScrtEnd0130Flare_en.ogg"], ["- Lizzie: \"Hello, stranger.\"", "DGrtingNoScrtEnd0140Lizzie_en.ogg"], ["- Lizzie: \"Ah, the time-dancer.\"", "DGrtingNoScrtEnd0150Lizzie_en.ogg"], ["- Lizzie: \"Speak to Us, demon.\"", "DGrtingNoScrtEnd0160Lizzie_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Greetings", "Best Friends"], "idle": false, "lines": [["- Flare: \"Hey, Lizzie, look who it is!\"", "FlareGreetBF_FLook.ogg"], ["- Flare: \"Hey, friend.\"", "FlareGreetBF_FFriend.ogg"], ["- Flare: \"Dunno how we're ever gonna thank you.\"", "FlareGreetBF_FThank.ogg"], ["- Flare: \"Any time you wanna collaborate...\"", "FlareGreetBF_FCollab.ogg"], ["- Lizzie: \"Blessed demon!\"", "FlareGreetBF_LBlessed.ogg"], ["- Lizzie: \"We are One. We welcome you.\"", "FlareGreetBF_LWelcome.ogg"], ["- Lizzie: \"You are embraced.\"", "FlareGreetBF_LEmbraced.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Shop", "Viewing Wares"], "idle": false, "lines": [["- Flare: \"Here's what we got.\"", "DOpenStore0240Flare_en.ogg"], ["- Flare: \"Everything I could scrape together.\"", "DOpenStore0250Flare_en.ogg"], ["- Flare: \"Just a few personal treasures.\"", "DOpenStore0260Flare_en.ogg"], ["- Lizzie: \"They left Us so very little.\"", "DOpenStore0280Lizzie_en.ogg"], ["- Lizzie: \"Mmmm. Merch stand.\"", "DOpenStore0270Lizzie_en.ogg"], ["- Lizzie: \"All that remains of the dream.\"", "DOpenStore0290Lizzie_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Shop", "While Browsing"], "idle": false, "lines": [["- Flare: \"They can hurt you, they can break your body, but they can't make you lie.\"", "DStoreIdleBarks0460Flare_en.ogg"], ["- Flare: \"You gotta tell the truth on that stage. Use whatever craft you need to make it sing, but don't ever fake it.\"", "DStoreIdleBarks0470Flare_en.ogg"], ["- Flare: \"The glare and the glitter were never a mask. They were a message. Look at me, see me, because I'm not changing myself for you.\"", "DStoreIdleBarks0480Flare_en.ogg"], ["- Flare: \"I reckon we're gonna burn up one day, like a hero on the solstice bonfire. It's funny how the crowd always wants a sacrifice.\"", "DStoreIdleBarks0490Flare_en.ogg"], ["- Lizzie: \"Every artist needs a devil on their shoulder... or a monkey on their back.\"", "DStoreIdleBarks0500Lizzie_en.ogg"], ["- Lizzie: \"Sickness, fever, heat and madness. Love sings the same lyrics as disease.\"", "DStoreIdleBarks0510Lizzie_en.ogg"], ["- Lizzie: \"They were always Ours. Marked out from birth. Just as you were.\"", "DStoreIdleBarks0520Lizzie_en.ogg"], ["- Lizzie: \"When the dreamers wake and the lidless eyes turn upon them, We shall sing the last number of the night.\"", "DStoreIdleBarks0530Lizzie_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Shop", "Leaving After Purchasing An Item"], "idle": false, "lines": [["- Flare: \"Keep it real.\"", "DOutroSale0340Flare_en.ogg"], ["- Flare: \"In the bag.\"", "DOutroSale0350Flare_en.ogg"], ["- Lizzie: \"Oooh, good choice.\"", "DOutroSale0360Lizzie_en.ogg"], ["- Lizzie: \"Delightful!\"", "DOutroSale0370Lizzie_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Shop", "Leaving Without Purchasing"], "idle": false, "lines": [["- Flare: \"Okay.\"", "DOutroNoSale0300Flare_en.ogg"], ["- Flare: \"You need a minute?\"", "DOutroNoSale0310Flare_en.ogg"], ["- Lizzie: \"Very well.\"", "DOutroNoSale0320Lizzie_en.ogg"], ["- Lizzie: \"We shall wait.\"", "DOutroNoSale0330Lizzie_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Farewells", "Normal"], "idle": false, "lines": [["- Flare: \"Uh... bye.\"", "DMall0380Flare_en.ogg"], ["- Flare: \"Well, if you gotta leave...\"", "DMall0390Flare_en.ogg"], ["- Lizzie: \"Yes. Run along.\"", "DMall0400Lizzie_en.ogg"], ["- Lizzie: \"Flare is Ours, demon.\"", "DMall0410Lizzie_en.ogg"]]},
  {"path": ["In Höllvania Central Mall", "Farewells", "Best Friends"], "idle": false, "lines": [["- Flare: \"See your space face later.\"", "FlareFarewellBF_FSpaceFace.ogg"], ["- Flare: \"Us weirdos gotta stick together.\"", "FlareFarewellBF_FWeirdo.ogg"], ["- Lizzie: \"Remember, We are your flesh!\"", "FlareFarewellBF_LFlesh.ogg"], ["- Lizzie: \"Entwine... forever.\"", "FlareFarewellBF_LEntwine.ogg"]]},
  {"path": ["During Stage Defense"], "idle": false, "lines": [["See Defense/Quotes#Stage_Defense.", null]]},
  {"path": ["Gemini Skin", "Gemini Switch Emote"], "idle": false, "lines": [["- Flare: \"Let's rock.\"", "DSwitchProto1810Flare_en.ogg"], ["- Flare: \"You wanna burn this shithouse down?\"", "DSwitchProto1820Flare_en.ogg"], ["- Flare: \"Feeling fabulous, darling.\"", "DSwitchProto1830Flare_en.ogg"], ["- Flare: \"Let's hit the road!\"", "DSwitchProto1840Flare_en.ogg"], ["- Flare: \"C'mon. Our audience is waiting.\"", "DSwitchProto1850Flare_en.ogg"], ["- Flare: \"Welcome to the party at the end of the world.\"", "DSwitchProto1860Flare_en.ogg"], ["- Flare: \"Please, allow me to introduce myself.\"", "DSwitchProto1870Flare_en.ogg"], ["- Flare: \"I got a dozen different chemicals slam dancing in my blood.\"", "DSwitchProto1880Flare_en.ogg"], ["- Flare: \"Okay, losers. Let's go!\"", "DSwitchProto1890Flare_en.ogg"], ["- Flare: \"Who left the asylum doors open?\"", "DSwitchProto1900Flare_en.ogg"], ["- Lizzie: \"Unfold like a rose beneath the poison skies!\"", "DSwitchProto1910Lizzie_en.ogg"], ["- Lizzie: \"Kick it.\"", "DSwitchProto1920Lizzie_en.ogg"], ["- Lizzie: \"Lift up your hands!\"", "DSwitchProto1930Lizzie_en.ogg"], ["- Lizzie: \"The people want a show, so let's give 'em one!\"", "DSwitchProto1940Lizzie_en.ogg"], ["- Lizzie: \"Do you feel it, pumping in your head?\"", "DSwitchProto1950Lizzie_en.ogg"], ["- Lizzie: \"Join Us. Embrace Us.\"", "DSwitchProto1960Lizzie_en.ogg"], ["- Lizzie: \"Our flesh will burn as one!\"", "DSwitchProto1970Lizzie_en.ogg"], ["- Lizzie: \"Ah, Flare... sweetest flower in the savage garden.\"", "DSwitchProto1980Lizzie_en.ogg"], ["- Lizzie: \"Ready to make an entrance?\"", "DSwitchProto1990Lizzie_en.ogg"], ["- Lizzie: \"Fire it up!\"", "DSwitchProto2000Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Transference to Operator/Drifter"], "idle": false, "lines": [["- Flare: \"You spread your wings, my friend.\"", "DTransToOp0810Flare_en.ogg"], ["- Flare: \"The starlight wanderer has taken flight.\"", "DTransToOp0820Flare_en.ogg"], ["- Flare: \"You're leaving me alone here? With her?\"", "DTransToOp0830Flare_en.ogg"], ["- Flare: \"Whoo. Vapour trails.\"", "DTransToOp0840Flare_en.ogg"], ["- Flare: \"Is that an angel I see?\"", "DTransToOp0850Flare_en.ogg"], ["- Flare: \"If you gotta go, you gotta go.\"", "DTransToOp0860Flare_en.ogg"], ["- Flare: \"I might do some crazy shit without you keeping me in check.\"", "DTransToOp0870Flare_en.ogg"], ["- Flare: \"Just me... and the whispers. \"", "DTransToOp0880Flare_en.ogg"], ["- Flare: \"I may start screaming. Best get used to it.\"", "DTransToOp0890Flare_en.ogg"], ["- Flare: \"Leaving 'cause of creative differences?\"", "DTransToOp0900Flare_en.ogg"], ["- Lizzie: \"Flare will be just fine with me, sugar.\"", "DTransToOp0910Lizzie_en.ogg"], ["- Lizzie: \"Yeah. You go take a nice long walk.\"", "DTransToOp0920Lizzie_en.ogg"], ["- Lizzie: \"Three's a crowd, sugar.\"", "DTransToOp0930Lizzie_en.ogg"], ["- Lizzie: \"Fly, demon!\"", "DTransToOp0940Lizzie_en.ogg"], ["- Lizzie: \"Give our regards to the Smiling One.\"", "DTransToOp0950Lizzie_en.ogg"], ["- Lizzie: \"You're nothing but cobwebs and starlight!\"", "DTransToOp0960Lizzie_en.ogg"], ["- Lizzie: \"Raggedy ghost, go play by yourself for a while.\"", "DTransToOp0970Lizzie_en.ogg"], ["- Lizzie: \"You never needed this flesh anyhow.\"", "DTransToOp0980Lizzie_en.ogg"], ["- Lizzie: \"Take your time.\"", "DTransToOp0990Lizzie_en.ogg"], ["- Lizzie: \"Godspeed, star-treader.\"", "DTransToOp1000Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Transference to Warframe"], "idle": false, "lines": [["- Flare: \"Where in hell have you been?\"", "DTransToFrame1010Flare_en.ogg"], ["- Flare: \"Welcome back. I was starting to lose it.\"", "DTransToFrame1020Flare_en.ogg"], ["- Flare: \"I wish I could remember the music I hear when you're gone.\"", "DTransToFrame1030Flare_en.ogg"], ["- Flare: \"Yeah. Come on in. Hold me together.\"", "DTransToFrame1040Flare_en.ogg"], ["- Flare: \"You really want to take the wheel of a burning car?\"", "DTransToFrame1050Flare_en.ogg"], ["- Flare: \"Ohhh, wrap around my brain like a blanket.\"", "DTransToFrame1060Flare_en.ogg"], ["- Flare: \"Here's my poor wayfaring stranger.\"", "DTransToFrame1070Flare_en.ogg"], ["- Flare: \"I knew you wouldn't leave me for long.\"", "DTransToFrame1090Flare_en.ogg"], ["- Lizzie: \"Do not seek to quench Our fire!\"", "DTransToFrame1110Lizzie_en.ogg"], ["- Lizzie: \"Join Us, lesser voice. In harmony.\"", "DTransToFrame1120Lizzie_en.ogg"], ["- Lizzie: \"Oh. You're back already.\"", "DTransToFrame1130Lizzie_en.ogg"], ["- Lizzie: \"Flare is well. We have not devoured them.\"", "DTransToFrame1140Lizzie_en.ogg"], ["- Lizzie: \"Descend the spiral into Our boiling bliss.\"", "DTransToFrame1150Lizzie_en.ogg"], ["- Lizzie: \"The mighty bloodstream of the Void washes you back to Us!\"", "DTransToFrame1160Lizzie_en.ogg"], ["- Lizzie: \"You're like an infection yourself, sugar. Hard to shake.\"", "DTransToFrame1170Lizzie_en.ogg"], ["- Lizzie: \"Raise Them up, hand in ungovernable hand.\"", "DTransToFrame1180Lizzie_en.ogg"], ["- Lizzie: \"Hey, Flare, look who's back.\"", "DTransToFrame1190Lizzie_en.ogg"], ["- Lizzie: \"You and me and the baby makes three...\"", "DTransToFrame1200Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Under Fire"], "idle": false, "lines": [["- Flare: \"We got hostiles!\"", "DUndFire0610Flare_en.ogg"], ["- Flare: \"Aggro!\"", "DUndFire0620Flare_en.ogg"], ["- Flare: \"Zone is hot!\"", "DUndFire0630Flare_en.ogg"], ["- Flare: \"They're comin' for us.\"", "DUndFire0640Flare_en.ogg"], ["- Flare: \"I think we pissed 'em off.\"", "DUndFire0650Flare_en.ogg"], ["- Flare: \"Heads up!\"", "DUndFire0660Flare_en.ogg"], ["- Flare: \"I can hear fight music!\"", "DUndFire0670Flare_en.ogg"], ["- Flare: \"Bring it, bitches.\"", "DUndFire0680Flare_en.ogg"], ["- Flare: \"Yeah. Let's play.\"", "DUndFire0690Flare_en.ogg"], ["- Flare: \"You assholes wanna burn?\"", "DUndFire0700Flare_en.ogg"], ["- Lizzie: \"Blood is in the air!\"", "DUndFire0710Lizzie_en.ogg"], ["- Lizzie: \"We taste violence!\"", "DUndFire0720Lizzie_en.ogg"], ["- Lizzie: \"Ah, the ambrosia of imminent death.\"", "DUndFire0730Lizzie_en.ogg"], ["- Lizzie: \"Sever them!\"", "DUndFire0740Lizzie_en.ogg"], ["- Lizzie: \"Let their screams be a song!\"", "DUndFire0750Lizzie_en.ogg"], ["- Lizzie: \"We burn. We hunger!\"", "DUndFire0760Lizzie_en.ogg"], ["- Lizzie: \"Do they not appreciate Us?\"", "DUndFire0770Lizzie_en.ogg"], ["- Lizzie: \"We want everybody on their feet!\"", "DUndFire0780Lizzie_en.ogg"], ["- Lizzie: \"Are you ready?\"", "DUndFire0790Lizzie_en.ogg"], ["- Lizzie: \"Back into Hell!\"", "DUndFire0800Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Killing Enemies"], "idle": false, "lines": [["- Flare: \"One down.\"", "DEliminated0010Flare_en.ogg"], ["- Flare: \"All done.\"", "DEliminated0020Flare_en.ogg"], ["- Flare: \"Blew em' away!\"", "DEliminated0030Flare_en.ogg"], ["- Flare: \"Ciao, baby.\"", "DEliminated0040Flare_en.ogg"], ["- Flare: \"They're gone.\"", "DEliminated0050Flare_en.ogg"], ["- Flare: \"Took one out!\"", "DEliminated0060Flare_en.ogg"], ["- Flare: \"Sayonara, honey.\"", "DEliminated0070Flare_en.ogg"], ["- Flare: \"Bang bang.\"", "DEliminated0080Flare_en.ogg"], ["- Flare: \"Had to be done.\"", "DEliminated0090Flare_en.ogg"], ["- Flare: \"Takes care of you.\"", "DEliminated0100Flare_en.ogg"], ["- Lizzie: \"Glorious death!\"", "DEliminated0110Lizzie_en.ogg"], ["- Lizzie: \"They are fallen.\"", "DEliminated0120Lizzie_en.ogg"], ["- Lizzie: \"Slaughter feeds Us.\"", "DEliminated0130Lizzie_en.ogg"], ["- Lizzie: \"We rejoice!\"", "DEliminated0140Lizzie_en.ogg"], ["- Lizzie: \"They checked out!\"", "DEliminated0150Lizzie_en.ogg"], ["- Lizzie: \"Too bad, baby.\"", "DEliminated0160Lizzie_en.ogg"], ["- Lizzie: \"You're nothing.\"", "DEliminated0170Lizzie_en.ogg"], ["- Lizzie: \"Shredded!\"", "DEliminated0180Lizzie_en.ogg"], ["- Lizzie: \"You lose!\"", "DEliminated0190Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Mercy Finishers"], "idle": false, "lines": [["- Flare: \"Did you all see that?\"", "DMercy1610Flare_en.ogg"], ["- Flare: \"Biiig finish!\"", "DMercy1620Flare_en.ogg"], ["- Flare: \"I'm sweatin' after that.\"", "DMercy1630Flare_en.ogg"], ["- Flare: \"Don't ever think you can break me.\"", "DMercy1640Flare_en.ogg"], ["- Flare: \"What, you thought this was all an act?\"", "DMercy1650Flare_en.ogg"], ["- Flare: \"We don't play nice with tyrants.\"", "DMercy1660Flare_en.ogg"], ["- Flare: \"Revolution ain't just a word.\"", "DMercy1670Flare_en.ogg"], ["- Flare: \"You wanna riot?\"", "DMercy1680Flare_en.ogg"], ["- Flare: \"We kill to survive.\"", "DMercy1690Flare_en.ogg"], ["- Flare: \"Shoulda stepped aside when you had the chance!\"", "DMercy1700Flare_en.ogg"], ["- Lizzie: \"Our sweet hands are slathered with their death!\"", "DMercy1710Lizzie_en.ogg"], ["- Lizzie: \"We shall sing them a funeral dirge.\"", "DMercy1720Lizzie_en.ogg"], ["- Lizzie: \"We shall write your memorial in neon and vomit!\"", "DMercy1730Lizzie_en.ogg"], ["- Lizzie: \"Decompose forever in the sarcophagus of Our song!\"", "DMercy1740Lizzie_en.ogg"], ["- Lizzie: \"Let the angel rats gnaw upon your remnants!\"", "DMercy1750Lizzie_en.ogg"], ["- Lizzie: \"The wicked children shall be kicked out of Paradise!\"", "DMercy1760Lizzie_en.ogg"], ["- Lizzie: \"You tried to harm Our sweet Flare!\"", "DMercy1770Lizzie_en.ogg"], ["- Lizzie: \"You shall never take them! Never!\"", "DMercy1780Lizzie_en.ogg"], ["- Lizzie: \"Any who seek to part Us will burn!\"", "DMercy1790Lizzie_en.ogg"], ["- Lizzie: \"You wanna dance with demons, you better keep up the pace!\"", "DMercy1800Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Downed"], "idle": false, "lines": [["- Flare: \"Help!\"", "DDowned0210Flare_en.ogg"], ["- Flare: \"Oh, this really isn't looking good.\"", "DDowned0220Flare_en.ogg"], ["- Flare: \"No. Please. Not yet.\"", "DDowned0230Flare_en.ogg"], ["- Flare: \"I might not be walking away from this one.\"", "DDowned0240Flare_en.ogg"], ["- Flare: \"I've been beaten up before, but never this bad.\"", "DDowned0250Flare_en.ogg"], ["- Flare: \"Tough... crowd.\"", "DDowned0260Flare_en.ogg"], ["- Flare: \"Didn't plan on going out like this.\"", "DDowned0270Flare_en.ogg"], ["- Flare: \"Hey, Lizzie... one last song?\"", "DDowned0280Flare_en.ogg"], ["- Flare: \"Thank all the Gods... they missed my face.\"", "DDowned0290Flare_en.ogg"], ["- Flare: \"They beat the shit out of me.\"", "DDowned0300Flare_en.ogg"], ["- Lizzie: \"Assist Flare, you fools!\"", "DDowned0310Lizzie_en.ogg"], ["- Lizzie: \"Do not let Our songbird die!\"", "DDowned0320Lizzie_en.ogg"], ["- Lizzie: \"Help them, and We will be... forgiving.\"", "DDowned0330Lizzie_en.ogg"], ["- Lizzie: \"If Flare dies, We shall not forgive.\"", "DDowned0340Lizzie_en.ogg"], ["- Lizzie: \"Would you cast your sweet Flare aside like so much human trash?\"", "DDowned0350Lizzie_en.ogg"], ["- Lizzie: \"NO! They cannot hurt Flare! Only We can hurt Flare!\"", "DDowned0360Lizzie_en.ogg"], ["- Lizzie: \"Blood calls for blood!\"", "DDowned0370Lizzie_en.ogg"], ["- Lizzie: \"See how the bleeding artist crawls and begs for a few... seconds... more.\"", "DDowned0380Lizzie_en.ogg"], ["- Lizzie: \"Drink deep of the pain, Flare!\"", "DDowned0390Lizzie_en.ogg"], ["- Lizzie: \"Are you so careless with all your toys, demon?\"", "DDowned0400Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Revived"], "idle": false, "lines": [["- Flare: \"You thought we were done?\"", "DRevived0410Flare_en.ogg"], ["- Flare: \"The show must go on.\"", "DRevived0420Flare_en.ogg"], ["- Flare: \"You can't kill the beat.\"", "DRevived0430Flare_en.ogg"], ["- Flare: \"We are more than just flesh.\"", "DRevived0440Flare_en.ogg"], ["- Flare: \"We won't be silenced that easily.\"", "DRevived0450Flare_en.ogg"], ["- Flare: \"Mosh pit rule: if they're down, get 'em up. Thanks.\"", "DRevived0460Flare_en.ogg"], ["- Flare: \"Rippers forever!\"", "DRevived0470Flare_en.ogg"], ["- Flare: \"Try and tear me down, assholes.\"", "DRevived0480Flare_en.ogg"], ["- Flare: \"My mission's not over.\"", "DRevived0490Flare_en.ogg"], ["- Flare: \"Back by popular demand!\"", "DRevived0500Flare_en.ogg"], ["- Lizzie: \"The fire and the thunder!\"", "DRevived0510Lizzie_en.ogg"], ["- Lizzie: \"Make some noise!\"", "DRevived0520Lizzie_en.ogg"], ["- Lizzie: \"Yet again We clamber forth from the pit.\"", "DRevived0530Lizzie_en.ogg"], ["- Lizzie: \"Reborn in blood and feedback!\"", "DRevived0540Lizzie_en.ogg"], ["- Lizzie: \"Beware. We live.\"", "DRevived0550Lizzie_en.ogg"], ["- Lizzie: \"Dominion!\"", "DRevived0560Lizzie_en.ogg"], ["- Lizzie: \"We shall feast upon those who would silence Us.\"", "DRevived0570Lizzie_en.ogg"], ["- Lizzie: \"Sweet demon! Blessed demon!\"", "DRevived0580Lizzie_en.ogg"], ["- Lizzie: \"We rise.\"", "DRevived0590Lizzie_en.ogg"], ["- Lizzie: \"Another time, Death!\"", "DRevived0600Lizzie_en.ogg"]]},
  {"path": ["Gemini Skin", "Marking Waypoint"], "idle": false, "lines": [["- Flare: \"Spotlight over here.\"", "DLocMark1210Flare_en.ogg"], ["- Flare: \"Got a marker.\"", "DLocMark1220Flare_en.ogg"], ["- Flare: \"Tagging.\"", "DLocMark1230Flare_en.ogg"], ["- Flare: \"You wanna check this out?\"", "DLocMark1240Flare_en.ogg"], ["- Flare: \"Give this a look over.\"", "DLocMark1250Flare_en.ogg"], ["- Flare: \"Can we get a security check over here?\"", "DLocMark1260Flare_en.ogg"], ["- Flare: \"Someone take a look.\"", "DLocMark1270Flare_en.ogg"], ["- Flare: \"Need some marker tape down here!\"", "DLocMark1280Flare_en.ogg"], ["- Flare: \"Over here!\"", "DLocMark1290Flare_en.ogg"], ["- Flare: \"Anyone else see what I'm seeing?\"", "DLocMark1300Flare_en.ogg"], ["- Lizzie: \"Take note!\"", "DLocMark1310Lizzie_en.ogg"], ["- Lizzie: \"Eyes over here, sugar!\"", "DLocMark1320Lizzie_en.ogg"], ["- Lizzie: \"On Our mark!\"", "DLocMark1330Lizzie_en.ogg"], ["- Lizzie: \"Give this some attention.\"", "DLocMark1340Lizzie_en.ogg"], ["- Lizzie: \"Check it!\"", "DLocMark1350Lizzie_en.ogg"], ["- Lizzie: \"Your attention please!\"", "DLocMark1360Lizzie_en.ogg"], ["- Lizzie: \"We are sensing something.\"", "DLocMark1370Lizzie_en.ogg"], ["- Lizzie: \"Take a stroll over yonder.\"", "DLocMark1380Lizzie_en.ogg"], ["- Lizzie: \"Do you SEE?\"", "DLocMark1390Lizzie_en.ogg"], ["- Lizzie: \"Flare thinks We should investigate.\"", "DLocMark1400Lizzie_en.ogg"]]},
