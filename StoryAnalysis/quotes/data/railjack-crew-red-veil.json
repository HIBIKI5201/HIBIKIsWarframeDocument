 "sections": [
  {"path": [], "idle": false, "lines": [["Red Veil NPC crew dialogue voiced by Torian Brackett.", null]]},
  {"path": ["On Railjack", "Greetings"], "idle": false, "lines": [["- \"Yo.\"", "DRJCrewGreet2180RJRVMale_en.ogg"], ["- \"What?\"", "DRJCrewGreet2190RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Idle"], "idle": true, "lines": [["- \"House Zetki were artists. When they killed, they killed with finesse. Purpose. Just like me. This system's rotten, and me? I'm a scalpel.\"", "DRJCrewIdle2200RJRVMale_en.ogg"], ["- \"Fact is, every stable foundation is built on meat and blood. Now most people: they pretend it ain't so. It is not to their taste. Me? Hell. Me: I am one hardcore carnivore. For the greater good, course.\"", "DRJCrewIdle2210RJRVMale_en.ogg"], ["- \"Red Veil do the things most people can't. Without that nothing survives. No cost too great, no blood to precious is what we say. As long is ain't mine.\"", "DRJCrewIdle2220RJRVMale_en.ogg"], ["- \"Torture someone long enough they'll confess to anything. That's my favorite thing about it.\"", "DRJCrewIdle2230RJRVMale_en.ogg"], ["- \"So. That Helminth thing you mentioned? You ever fed anyone to it?\"", "DRJCrewIdle2240RJRVMale_en.ogg"], ["- \"Know what I love about this ship? Everyone pulls their weight. I been on Veil ships where we had freeloaders. One guy got so damned indolent I had to eat the bastard.\"", "DRJCrewIdle2250RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to a valid role"], "idle": false, "lines": [["- \"Seriously? Fine.\"", "DRJCrewAccept2260RJRVMale_en.ogg"], ["- \"You know me.\"", "DRJCrewAccept2270RJRVMale_en.ogg"], ["- \"You got it.\"", "DRJCrewAccept2280RJRVMale_en.ogg"], ["- \"What am I, your maid? Okay, okay.\"", "DRJCrewAccept2290RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to an invalid role"], "idle": false, "lines": [["- \"Yeah, can't do that.\"", "DRJCrewReject2340RJRVMale_en.ogg"], ["- \"Uh... negative.\"", "DRJCrewReject2350RJRVMale_en.ogg"], ["- \"Nah. Not happenin'.\"", "DRJCrewReject2360RJRVMale_en.ogg"], ["- \"Ha! No.\"", "DRJCrewReject2370RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Follow command"], "idle": false, "lines": [["- \"All right, all right. No troubles big show.\"", "DRJCrewFollow2300RJRVMale_en.ogg"], ["- \"What's up?\"", "DRJCrewFollow2310RJRVMale_en.ogg"], ["- \"Sure, fine... what's on your mind?\"", "DRJCrewFollow2320RJRVMale_en.ogg"], ["- \"Got your back!\"", "DRJCrewFollow2330RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Fighter approaching"], "idle": false, "lines": [["- \"Flyboys inbound, just letting you know.\"", "DRJCrewGunSpotFighter2470RJRVMale_en.ogg"], ["- \"Looks like they launched fighters!\"", "DRJCrewGunSpotFighter2480RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Fighter killed"], "idle": false, "lines": [["- \"Spacemen go boom!\"", "DRJCrewGunKillFighter2490RJRVMale_en.ogg"], ["- \"And with my flaming brand and crimson hand did I burn away the corrupt and ignite the heavens.\"", "DRJCrewGunKillFighter2500RJRVMale_en.ogg"], ["- \"Fighter down, moron dead. System's healthier for the loss.\"", "DRJCrewGunKillFighter2510RJRVMale_en.ogg"], ["- \"Scratch one fighter.\"", "DRJCrewGunKillFighter2520RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Boarding party"], "idle": false, "lines": [["- \"All right, let's thin this herd!\"", "DRJCrewEnemySpot2410RJRVMale_en.ogg"], ["- \"Haha, look at these total pylons. Hey, we've got boarders!\"", "DRJCrewEnemySpot2420RJRVMale_en.ogg"], ["- \"All right, let's clean out the gene pool. We got boarders!\"", "DRJCrewEnemySpot2430RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Boarder killed"], "idle": false, "lines": [["- \"Turnin' this place into a boneyard!\"", "DRJCrewEnemyDefeat2440RJRVMale_en.ogg"], ["- \"C'mon, these guys ain't even trying. Doin' the System a favor, cleaning them out!\"", "DRJCrewEnemyDefeat2450RJRVMale_en.ogg"], ["- \"Dead deadity dead. Hahaha.\"", "DRJCrewEnemyDefeat2460RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Completing a task"], "idle": false, "lines": [["- \"Got it done.\"", "DRJCrewTaskDone2380RJRVMale_en.ogg"], ["- \"It's in the bag.\"", "DRJCrewTaskDone2390RJRVMale_en.ogg"], ["- \"Yeah, job's done.\"", "DRJCrewTaskDone2400RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Railjack health low"], "idle": false, "lines": [["- \"At this rate we're all gonna be sucking vacuum, chief!\"", "DRJCrewShipLow2530RJRVMale_en.ogg"], ["- \"Hull's gonna need a new paint job.\"", "DRJCrewShipLow2540RJRVMale_en.ogg"], ["- \"So, you know this bucket ain't bulletproof, right?\"", "DRJCrewShipLow2550RJRVMale_en.ogg"], ["- \"We either need a stronger hull or a better pilot!\"", "DRJCrewShipLow2560RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Hazard on board"], "idle": false, "lines": [["**Fire**", null], ["- \"Uh, fire here. Might wanna put that out.\"", "DRJCrewSeeFire2570RJRVMale_en.ogg"], ["- \"Yo! Fire over here!\"", "DRJCrewSeeFire2580RJRVMale_en.ogg"], ["**Hull breach**", null], ["- \"Hull's busted! We are pissing our atmo away!\"", "DRJCrewSeeBreach2590RJRVMale_en.ogg"], ["- \"Oh, crap. Hull breach!\"", "DRJCrewSeeBreach2600RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Repairing hazard"], "idle": false, "lines": [["**Fire**", null], ["- \"Fire's out.\"", "DRJCrewFixFire2610RJRVMale_en.ogg"], ["- \"Fires dealt with.\"", "DRJCrewFixFire2620RJRVMale_en.ogg"], ["**Hull breach**", null], ["- \"Fixed the hull! Thank me later.\"", "DRJCrewFixBreach2630RJRVMale_en.ogg"], ["- \"Oof, breach sealed. She'll hold... I think.\"", "DRJCrewFixBreach2640RJRVMale_en.ogg"], ["**Out of revolite**", null], ["- \"Fresh out of revolite!\"", "DRJCrewNeedRevolite2650RJRVMale_en.ogg"], ["- \"Gonna need to restock on revolite!\"", "DRJCrewNeedRevolite2660RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Health low"], "idle": false, "lines": [["- \"I ain't goin' out like this! No way!\"", "DRJCrewNearDeath2670RJRVMale_en.ogg"], ["- \"No cost too great! No blood too precious!\"", "DRJCrewNearDeath2680RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Downed"], "idle": false, "lines": [["- \"I'm down! Help me up, or finish me off!\"", "DRJCrewNeedRevive2690RJRVMale_en.ogg"], ["- \"Better get to me quick if you wanna keep me breathing!\"", "DRJCrewNeedRevive2700RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Revived"], "idle": false, "lines": [["- \"Great. Now I owe ya.\"", "DRJCrewHeal2710RJRVMale_en.ogg"], ["- \"Ah, don't fix me too nice. I wanna keep the scar.\"", "DRJCrewHeal2720RJRVMale_en.ogg"], ["**Self-revive**", null], ["- \"Taking care of my wounds! See mother? Needlework was useful!\"", "DRJCrewHealSelf2730RJRVMale_en.ogg"], ["- \"Slapping on a medpack!\"", "DRJCrewHealSelf2740RJRVMale_en.ogg"]]},
  {"path": ["On Railjack", "Ally dead"], "idle": false, "lines": [["- \"We just lost one of our own! Grieve later. For now, be pissed off!\"", "DRJCrewDied2750RJRVMale_en.ogg"], ["- \"Save the med-packs, they're dead. Cap, we lost one!\"", "DRJCrewDied2760RJRVMale_en.ogg"]]},
  {"path": ["On Equipping"], "idle": false, "lines": [["- \"Seriously?\"", "DRJCrewHired2770RJRVMale_en.ogg"], ["- \"Yeah, okay. I hope you ain't squeamish.\"", "DRJCrewHired2780RJRVMale_en.ogg"], ["- \"Alright, let's you and me rinse this stinking system.\"", "DRJCrewHired2790RJRVMale_en.ogg"]]}
 ]
}
