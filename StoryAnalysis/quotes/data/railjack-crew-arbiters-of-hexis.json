 "sections": [
  {"path": [], "idle": false, "lines": [["Arbiters of Hexis NPC crew dialogue voiced by Brendan Parry Kaufmann.", null]]},
  {"path": ["On Railjack", "Greetings"], "idle": false, "lines": [["- \"An honor to serve.\"", "DRJCrewGreet2900RJAHMale_en.ogg"], ["- \"Noble Tenno.\"", "DRJCrewGreet2910RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Idle"], "idle": true, "lines": [["- \"We tread the selfsame Void where the saga began. In the spaces between, we shall learn the truth. All is unfolding as it should.\"", "DRJCrewIdle2920RJAHMale_en.ogg"], ["- \"Let me be worthy of this great office. If I fail, I shall gaze unblinking into the core until my eyes are burned away. I swear it by the Zariman.\"", "DRJCrewIdle2930RJAHMale_en.ogg"], ["- \"The pain of truth is but the smarting of a cleansed wound. Those who stopped up the truth in themselves are like one impacted with his own filth.\"", "DRJCrewIdle2940RJAHMale_en.ogg"], ["- \"Never - make light of our duty to kill when necessary - in service - to the truth. A judgment written in blood - may never - be unwritten.\"", "DRJCrewIdle2950RJAHMale_en.ogg"], ["- \"Many shall ask: by what right do you judge us? And we shall answer: by what right do you question us?\"", "DRJCrewIdle2960RJAHMale_en.ogg"], ["- \"It is no sin to fail to see the truth. But to reject the truth once it is seen? That is sin unpardonable.\"", "DRJCrewIdle2970RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to a valid role"], "idle": false, "lines": [["- \"Immediately.\"", "DRJCrewAccept2980RJAHMale_en.ogg"], ["- \"I obey.\"", "DRJCrewAccept2990RJAHMale_en.ogg"], ["- \"I serve.\"", "DRJCrewAccept3000RJAHMale_en.ogg"], ["- \"I shall, Tenno.\"", "DRJCrewAccept3010RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to an invalid role"], "idle": false, "lines": [["- \"In truth, I cannot.\"", "DRJCrewReject3060RJAHMale_en.ogg"], ["- \"That cannot be done.\"", "DRJCrewReject3070RJAHMale_en.ogg"], ["- \"I am not able to comply.\"", "DRJCrewReject3080RJAHMale_en.ogg"], ["- \"I cannot.\"", "DRJCrewReject3090RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Follow command"], "idle": false, "lines": [["- \"I am with you.\"", "DRJCrewFollow3020RJAHMale_en.ogg"], ["- \"Understood, following.\"", "DRJCrewFollow3030RJAHMale_en.ogg"], ["- \"Lead me, Tenno.\"", "DRJCrewFollow3040RJAHMale_en.ogg"], ["- \"Show me the way.\"", "DRJCrewFollow3050RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Fighters approaching"], "idle": false, "lines": [["- \"I have sighted enemy fighters!\"", "DRJCrewGunSpotFighter3190RJAHMale_en.ogg"], ["- \"Fighters on route!\"", "DRJCrewGunSpotFighter3200RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Fighter killed"], "idle": false, "lines": [["- \"Corruption dies in fire.\"", "DRJCrewGunKillFighter3210RJAHMale_en.ogg"], ["- \"Target purged.\"", "DRJCrewGunKillFighter3220RJAHMale_en.ogg"], ["- \"Got them.\"", "DRJCrewGunKillFighter3230RJAHMale_en.ogg"], ["- \"Fighter destroyed.\"", "DRJCrewGunKillFighter3240RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Boarding party"], "idle": false, "lines": [["- \"Intruders! Let us punish them.\"", "DRJCrewEnemySpot3130RJAHMale_en.ogg"], ["- \"Boarders! Engaging.\"", "DRJCrewEnemySpot3140RJAHMale_en.ogg"], ["- \"We are invaded! Brace for slaughter!\"", "DRJCrewEnemySpot3150RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Boarder killed"], "idle": false, "lines": [["- \"Judgment has been visited upon their flesh.\"", "DRJCrewEnemyDefeat3160RJAHMale_en.ogg"], ["- \"I have taken another life.\"", "DRJCrewEnemyDefeat3170RJAHMale_en.ogg"], ["- \"Extreme correction has been carried out.\"", "DRJCrewEnemyDefeat3180RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Completing a task"], "idle": false, "lines": [["- \"The work is done.\"", "DRJCrewTaskDone3100RJAHMale_en.ogg"], ["- \"Task complete.\"", "DRJCrewTaskDone3110RJAHMale_en.ogg"], ["- \"I am finished.\"", "DRJCrewTaskDone3120RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Railjack health low"], "idle": false, "lines": [["- \"This noble vessel is being torn to pieces.\"", "DRJCrewShipLow3250RJAHMale_en.ogg"], ["- \"This ship is being flayed bare like a carcass.\"", "DRJCrewShipLow3260RJAHMale_en.ogg"], ["- \"Our ship is being desecrated down to her bones.\"", "DRJCrewShipLow3270RJAHMale_en.ogg"], ["- \"We cannot endure much more of this persecution.\"", "DRJCrewShipLow3280RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Hazard on board"], "idle": false, "lines": [["**Fire**", null], ["- \"Our vessel is burning!\"", "DRJCrewSeeFire3290RJAHMale_en.ogg"], ["- \"Fire! Contain it!\"", "DRJCrewSeeFire3300RJAHMale_en.ogg"], ["**Hull breach**", null], ["- \"Our hull has been gouged open!\"", "DRJCrewSeeBreach3310RJAHMale_en.ogg"], ["- \"Hull breach! Explosive decompression!\"", "DRJCrewSeeBreach3320RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Repairing hazard"], "idle": false, "lines": [["**Fire**", null], ["- \"Fire quenched.\"", "DRJCrewFixFire3330RJAHMale_en.ogg"], ["- \"The fire has been snuffed out.\"", "DRJCrewFixFire3340RJAHMale_en.ogg"], ["**Hull breach**", null], ["- \"I have repaired the grievous wound to our hull.\"", "DRJCrewFixBreach3350RJAHMale_en.ogg"], ["- \"Breach cauterized. Air bleed staunched.\"", "DRJCrewFixBreach3360RJAHMale_en.ogg"], ["**Out of revolite**", null], ["- \"I can locate no revolite!\"", "DRJCrewNeedRevolite3370RJAHMale_en.ogg"], ["- \"Necessary revolite is absent!\"", "DRJCrewNeedRevolite3380RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Health low"], "idle": false, "lines": [["- \"My strength is failing.\"", "DRJCrewNearDeath3390RJAHMale_en.ogg"], ["- \"The enemy threatens to overwhelm me!\"", "DRJCrewNearDeath3400RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Downed"], "idle": false, "lines": [["- \"I am dying. If you think me worth saving, please assist.\"", "DRJCrewNeedRevive3410RJAHMale_en.ogg"], ["- \"Death has come to claim me. I await your arbitration.\"", "DRJCrewNeedRevive3420RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Revived"], "idle": false, "lines": [["- \"I am restored.\"", "DRJCrewHeal3430RJAHMale_en.ogg"], ["- \"I shall repay this gesture.\"", "DRJCrewHeal3440RJAHMale_en.ogg"], ["**Self-revive**", null], ["- \"Tending to my wounds.\"", "DRJCrewHealSelf3450RJAHMale_en.ogg"], ["- \"Healing!\"", "DRJCrewHealSelf3460RJAHMale_en.ogg"]]},
  {"path": ["On Railjack", "Ally dead"], "idle": false, "lines": [["- \"Tenno, I have witnessed the death of a crewmember.\"", "DRJCrewDied3470RJAHMale_en.ogg"], ["- \"Verifying vital signs have ceased. Our crewmate is dead.\"", "DRJCrewDied3480RJAHMale_en.ogg"]]},
  {"path": ["On Equipping"], "idle": false, "lines": [["- \"You have chosen... me, of course. I shall prove worthy of your trust.\"", "DRJCrewHired3490RJAHMale_en.ogg"], ["- \"I pledge my lotalty to you, my captain. Let us speak only truth to one another.\"", "DRJCrewHired3500RJAHMale_en.ogg"], ["- \"To serve under a Tenno, onboard a restored Orokin Railjack. This is the vision. The apex of our dream.\"", "DRJCrewHired3510RJAHMale_en.ogg"]]}
 ]
}
