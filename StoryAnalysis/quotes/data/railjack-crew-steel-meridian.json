 "sections": [
  {"path": [], "idle": false, "lines": [["Steel Meridian NPC crew dialogue voiced by Gemma Laurelle.", null]]},
  {"path": ["On Railjack", "Greetings"], "idle": false, "lines": [["- \"Ready.\"", "DRJCrewGreet0010RJSMFem_en.ogg"], ["- \"Tenno.\"", "DRJCrewGreet0020RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Idle"], "idle": true, "lines": [["- \"I still hear them calling us to obey. Oh, I want to—very badly. Always ends with a bulkhead dented and my hand busted. Disobedience isn't a choice I only make once. It's a fah-sukh-ung lifestyle. And it hurts.\"", "DRJCrewIdle0030RJSMFem_en.ogg"], ["- \"Yes we eat our fallen brothers, we live short; kids, family, not for us, if Grineer live on it's through our brothers and our sisters by helping them to live after we have fallen. So shelve your judgment. Luxury makes me nauseous.\"", "DRJCrewIdle0040RJSMFem_en.ogg"], ["- \"There are others out there like me going it alone against everything they were created to be, knowing they're different, knowing why, knowing they'll never belong to anything ever again, I'm lucky, but I have a hard time living with that.\"", "DRJCrewIdle0050RJSMFem_en.ogg"], ["- \"Piece of advice, any of the crew wanna spend some private time together just let it happen, play some music, go for a walk, whatever. Don't play the hard ass we're all grownups and life's too short.\"", "DRJCrewIdle0060RJSMFem_en.ogg"], ["- \"We used to pass the time sniffing spent ammo casings *sniff* sometimes I'll decap a round just to get a whiff of musky vordite base with sharp Rubedo notes and a toasty magnesium finish. I'm kidding we never had fun.\"", "DRJCrewIdle0070RJSMFem_en.ogg"], ["- \"I did bad things, if I don't pay for my actions, I don't own myself, so here I am with you settling my tab, I may have been born a clone but I sure as hell ain't dying as one.\"", "DRJCrewIdle0080RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to a valid role"], "idle": false, "lines": [["- \"Copy.\"", "DRJCrewAccept0090RJSMFem_en.ogg"], ["- \"On it.\"", "DRJCrewAccept0100RJSMFem_en.ogg"], ["- \"Got that.\"", "DRJCrewAccept0110RJSMFem_en.ogg"], ["- \"Affirmative.\"", "DRJCrewAccept0120RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to an invalid role"], "idle": false, "lines": [["- \"Negative.\"", "DRJCrewReject0170RJSMFem_en.ogg"], ["- \"Not possible.\"", "DRJCrewReject0180RJSMFem_en.ogg"], ["- \"That's a negative.\"", "DRJCrewReject0190RJSMFem_en.ogg"], ["- \"No.\"", "DRJCrewReject0200RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Follow command"], "idle": false, "lines": [["- \"Rolling out.\"", "DRJCrewFollow0130RJSMFem_en.ogg"], ["- \"Falling in.\"", "DRJCrewFollow0140RJSMFem_en.ogg"], ["- \"On your six.\"", "DRJCrewFollow0150RJSMFem_en.ogg"], ["- \"Aye aye.\"", "DRJCrewFollow0160RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Fighters approaching"], "idle": false, "lines": [["- \"Enemy fighters on scope!\"", "DRJCrewGunSpotFighter0300RJSMFem_en.ogg"], ["- \"They've launched fighters!\"", "DRJCrewGunSpotFighter0310RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Fighter killed"], "idle": false, "lines": [["- \"Fighter destroyed.\"", "DRJCrewGunKillFighter0320RJSMFem_en.ogg"], ["- \"Kill confirmed.\"", "DRJCrewGunKillFighter0330RJSMFem_en.ogg"], ["- \"Splash one.\"", "DRJCrewGunKillFighter0340RJSMFem_en.ogg"], ["- \"Ha! He flew well.\"", "DRJCrewGunKillFighter0350RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Boarding party"], "idle": false, "lines": [["- \"Boarding in progress. Retaliating.\"", "DRJCrewEnemySpot0240RJSMFem_en.ogg"], ["- \"Invaders in the zone!\"", "DRJCrewEnemySpot0250RJSMFem_en.ogg"], ["- \"Pick your targets! Short, controlled bursts!\"", "DRJCrewEnemySpot0260RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Boarder killed"], "idle": false, "lines": [["- \"One down.\"", "DRJCrewEnemyDefeat0270RJSMFem_en.ogg"], ["- \"Dropped him.\"", "DRJCrewEnemyDefeat0280RJSMFem_en.ogg"], ["- \"Good kill!\"", "DRJCrewEnemyDefeat0290RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Completing a task"], "idle": false, "lines": [["- \"Done.\"", "DRJCrewTaskDone0210RJSMFem_en.ogg"], ["- \"Task complete.\"", "DRJCrewTaskDone0220RJSMFem_en.ogg"], ["- \"It is done.\"", "DRJCrewTaskDone0230RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Railjack health low"], "idle": false, "lines": [["- \"Our ship cannot take much more of this!\"", "DRJCrewShipLow0360RJSMFem_en.ogg"], ["- \"This ship is too pretty for combat! Fly better!\"", "DRJCrewShipLow0370RJSMFem_en.ogg"], ["- \"Give me a Grineer Crewship any day. We're coming apart!\"", "DRJCrewShipLow0380RJSMFem_en.ogg"], ["- \"Her vitals are redlining. Repair crew, to me!\"", "DRJCrewShipLow0390RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Hazard on board"], "idle": false, "lines": [["**Fire**", null], ["- \"Fire at my location.\"", "DRJCrewSeeFire0400RJSMFem_en.ogg"], ["- \"Fire crew. Fire crew!\"", "DRJCrewSeeFire0410RJSMFem_en.ogg"], ["**Hull breach**", null], ["- \"Hull breach! Losing atmo.\"", "DRJCrewSeeBreach0420RJSMFem_en.ogg"], ["- \"Hull breach. Repair crew!\"", "DRJCrewSeeBreach0430RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Repairing hazard"], "idle": false, "lines": [["**Fire**", null], ["- \"Fire's out.\"", "DRJCrewFixFire0440RJSMFem_en.ogg"], ["- \"No more fire.\"", "DRJCrewFixFire0450RJSMFem_en.ogg"], ["**Hull breach**", null], ["- \"Hull breach sealed. Hold your applause.\"", "DRJCrewFixBreach0460RJSMFem_en.ogg"], ["- \"Hull breach is sealed.\"", "DRJCrewFixBreach0470RJSMFem_en.ogg"], ["**Out of revolite**", null], ["- \"Revolite, now!\"", "DRJCrewNeedRevolite0480RJSMFem_en.ogg"], ["- \"We are out of revolite!\"", "DRJCrewNeedRevolite0490RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Health low"], "idle": false, "lines": [["- \"If I die, I die facing the enemy... with a weapon in my hand.\"", "DRJCrewNearDeath0500RJSMFem_en.ogg"], ["- \"If this is my end... SO BE IT!\"", "DRJCrewNearDeath0510RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Downed"], "idle": false, "lines": [["- \"Get me to my feet. I can kill a few more.\"", "DRJCrewNeedRevive0520RJSMFem_en.ogg"], ["- \"Agh! I am down!\"", "DRJCrewNeedRevive0530RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Revived"], "idle": false, "lines": [["- \"I am intact. I can keep fighting.\"", "DRJCrewHeal0540RJSMFem_en.ogg"], ["- \"You have done your duty. Now back to the fight.\"", "DRJCrewHeal0550RJSMFem_en.ogg"], ["**Self-heal**", null], ["- \"Good hit, gar gutora [you bitch]! Don't go anywhere, I'll be right back.\"", "DRJCrewHealSelf0560RJSMFem_en.ogg"], ["- \"I can take the pain! Keep fighting!\"", "DRJCrewHealSelf0570RJSMFem_en.ogg"]]},
  {"path": ["On Railjack", "Ally dead"], "idle": false, "lines": [["- \"One of our own has fallen! Keep fighting!\"", "DRJCrewDied0580RJSMFem_en.ogg"], ["- \"You... shall be avenged!\"", "DRJCrewDied0590RJSMFem_en.ogg"]]},
  {"path": ["When Equipped"], "idle": false, "lines": [["- \"Captain.\"", "DRJCrewHired0600RJSMFem_en.ogg"], ["- \"This is the one? So be it.\"", "DRJCrewHired0610RJSMFem_en.ogg"], ["- \"Reporting for duty.\"", "DRJCrewHired0620RJSMFem_en.ogg"]]}
 ]
}
