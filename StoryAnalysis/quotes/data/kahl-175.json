 },
 "count": 251,
 "idle": 10,
 "sections": [
  {"path": ["In Drifter's Camp", "First Meeting"], "idle": false, "lines": [["- Kahl: \"Who help Grineer today? Not Queens. Not Vay Hek. Only Tenno and Blue Girl help brothers. Other Brothers still have Veil. Kahl break Veils. Kahl help them like you help Kahl. Kahl not afraid.\"", "DVeilFirstIntro0090Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Idle", "Rank 1 - Shelter"], "idle": true, "lines": [["- Kahl: \"Good day today.\"", "DVeilIdleBarks0010Kahl_en.ogg"], ["- Kahl: \"Air smell... good. Clean.\"", "DVeilIdleBarks0020Kahl_en.ogg"], ["- Kahl: \"Kahl go fishing! Not catch dinner. New boot though!\"", "DVeilIdleBarks0060Kahl_en.ogg"], ["- Kahl: \"Narmer say Pazuul want to make new forest? Then Pazuul kill all people? Leave only animals? People animals too. Pazuul no make sense.\"", "DVeilIdleBarks0070Kahl_en.ogg"], ["- Kahl: \"Vay Hek try to kill forest but grow new brothers. Pazuul want grow new forest but kill brothers. Kahl just want to live in forest with brothers. Why that so hard?\"", "DVeilIdleBarks0080Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Idle", "Rank 2 - Encampment"], "idle": true, "lines": [["- Kahl: \"Ah, brother. You finish chores?\"", "DVeilIdleBarks0030Kahl_en.ogg"], ["- Kahl: \"When Blue Girl calls, be ready, brother.\"", "DVeilIdleBarks0040Kahl_en.ogg"], ["- Kahl: \"Brother, clean up food, or Kuaka come mess up everything.\"", "DVeilIdleBarks0050Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Idle", "Rank 3 - Fort"], "idle": true, "lines": [["Horrek: \"Kahl! When is your blue girl going to send us more polyps? I want my world to undulate again.\"", "DVeilRankTwoThreeFour1490Horrek_en.ogg"], ["- Kahl: \"She say you not allowed. She say 'He knows what he did'.\"", "DVeilRankTwoThreeFour1500Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Greetings"], "idle": false, "lines": [["- Kahl: \"Narmer take all. Kahl and brothers take all back. Kahl swear.\"", "DVeilRegIntro0100Kahl_en.ogg"], ["- Kahl: \"Tenno.\"", "DVeilRegIntro0110Kahl_en.ogg"], ["- Kahl: \"Tenno camp is best camp.\"", "DVeilRegIntro0120Kahl_en.ogg"], ["- Kahl: \"Tenno... go fishing later?\"", "DVeilRegIntro0130Kahl_en.ogg"], ["- Kahl: \"Huh. Blue Girl say she live in flower. Heh. Blue Girl joke with Kahl.\"", "DVeilRegIntro0140Kahl_en.ogg"], ["- Kahl: \"Ah. This good place. Quiet.\"", "DVeilRegIntro0150Kahl_en.ogg"], ["- Kahl: \"Tenno! Good see you.\"", "DVeilRegIntro0160Kahl_en.ogg"], ["- Kahl: \"Nothing come here. No worm. No Grineer.\"", "DVeilRegIntro0170Kahl_en.ogg"], ["- Kahl: \"Kahl like little flying guy. Talk lots, though.\"", "DVeilRegIntro0180Kahl_en.ogg"], ["- Kahl: \"Tenno... eat? We make Kuaka stew.\"", "DVeilRegIntro0190Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Farewells"], "idle": false, "lines": [["- Kahl: \"Tenno always welcome.\"", "DVeilBye0500Kahl_en.ogg"], ["- Kahl: \"Good luck against Archon.\"", "DVeilBye0510Kahl_en.ogg"], ["- Kahl: \"Kahl got your back.\"", "DVeilBye0520Kahl_en.ogg"], ["- Kahl: \"Kahl be here.\"", "DVeilBye0530Kahl_en.ogg"], ["- Kahl: \"Good working with Tenno.\"", "DVeilBye0540Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Customizing Kahl"], "idle": false, "lines": [["- Kahl: \"Kahl need to choose. Ugh.\"", "DVeilKahlCustomMenu0430Kahl_en.ogg"], ["- Kahl: \"Ah. In Grineer army Kahl only get one uniform. This is better.\"", "DVeilKahlCustomMenu0440Kahl_en.ogg"], ["- Kahl: \"What Kahl wear today?\"", "DVeilKahlCustomMenu0450Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Customizing Kahl", "Equipping Cosmetics/Material Structures"], "idle": false, "lines": [["- Kahl: \"Ah! Kahl look good.\"", "DVeilKahlCustomMenu0460Kahl_en.ogg"], ["- Kahl: \"Kahl like it.\"", "DVeilKahlCustomMenu0470Kahl_en.ogg"], ["- Kahl: \"Huh. Not to shabby.\"", "DVeilKahlCustomMenu0480Kahl_en.ogg"], ["- Kahl: \"Huh. Wait 'til Blue Girl see Kahl.\"", "DVeilKahlCustomMenu0490Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Viewing Break Narmer Mission"], "idle": false, "lines": [["- Kahl: \"Blue Girl find Narmer worms. Kahl stomp Narmer worms.\"", "DVeilGenMissionOffer0210Kahl_en.ogg"], ["- Kahl: \"Kahl itchy. Itchy to kill Narmer skoom.\"", "DVeilGenMissionOffer0200Kahl_en.ogg"], ["- Kahl: \"Kahl ready to deploy.\"", "DVeilGenMissionOffer0220Kahl_en.ogg"], ["- Kahl: \"Kahl have work to do.\"", "DVeilGenMissionOffer0230Kahl_en.ogg"], ["- Kahl: \"Blue Girl say we got veils to break.\"", "DVeilGenMissionOffer0240Kahl_en.ogg"]]},
  {"path": ["In Drifter's Camp", "Accepting Break Narmer Mission"], "idle": false, "lines": [["- Kahl: \"Mmhmm. Kahl ready.\"", "DVeilGenMissionAccept0250Kahl_en.ogg"], ["- Kahl: \"Good.\"", "DVeilGenMissionAccept0260Kahl_en.ogg"], ["- Kahl: \"Huh. 'Bout time.\"", "DVeilGenMissionAccept0270Kahl_en.ogg"], ["- Kahl: \"Moving out.\"", "DVeilGenMissionAccept0280Kahl_en.ogg"]]},
  {"path": ["Communications", "Rank 1 - Shelter"], "idle": false, "lines": [["- Kahl: \"Kahl 1-7-5 hear Blue Girl loud and clear.\"", "DVeilRankZeroOne0560Kahl_en.ogg"], ["- Kahl: \"Brothers need home. Kahl... Kahl find friend. Brothers and Kahl make home here instead. Kahl sorry.\"", "DVeilRankZeroOne0580Kahl_en.ogg"], ["- Kahl: \"Kahl not know 'sulk'. Kahl busy planning. Brothers need Kahl.\"", "DVeilRankZeroTwo0610Kahl_en.ogg"], ["- Kahl: \"Not everyone get to be bored. Kahl 'filthy clone'. Built to kill. Built to die. Kahl want to not be slave, to free brothers, he need to plan. To work. Maybe die. You want clown? Find other Kahl. Orokin made plenty.\"", "DVeilRankZeroTwo0631Kahl_en.ogg"]]},
  {"path": ["Communications", "Rank 2 - Encampment"], "idle": false, "lines": [["- Kahl: \"Kahl and brothers not slaves.\"", "DVeilRankOneOne0660Kahl_en.ogg"], ["- Kahl: \"No Captains. No Queens. Look around. Just Kahl, and brothers. Today: just us. Tomorrow: much more. Kahl and brothers not slave clones. Not any more.\"", "DVeilRankOneOne0680Kahl_en.ogg"], ["- Kahl: \"Emergency. Camp under attack. Worm Condrix sighted. Send assistance. Emergency!\"", "DVeilRankOneTwo0700Kahl_en.ogg"], ["- Kahl: \"Test done. Emergency channel work fine. Brothers, stand down.\"", "DVeilRankOneTwo0720Kahl_en.ogg"]]},
  {"path": ["Communications", "Rank 3 - Fort"], "idle": false, "lines": [["- Kahl: \"Blue Girl. Narmer veil make brothers love Pazuul. Kahl know that. But Kahl not know why brothers still love Queens. Why?\"", "DVeilRankTwoOne0740Kahl_en.ogg"], ["- Kahl: \"Does Blue Girl want change?\"", "DVeilRankTwoOne0760Kahl_en.ogg"], ["- Kahl: \"Fancy talk about rich old family. Empire. Orokin. But rich old Orokin family empire? Dust. This new world now. Kahl think Blue Girl want to be part of new world. That why she help Kahl make it. Kahl want to... help... Blue Girl, if Blue Girl want help?\"", "DVeilRankTwoOne0780Kahl_en.ogg"], ["- Kahl: \"Brothers not strangers. Blue Girl not love her family?\"", "DVeilRankTwoTwo0810Kahl_en.ogg"]]},
  {"path": ["Communications", "Rank 4 - Settlement"], "idle": false, "lines": [["- Kahl: \"Kahl part of brothers. Brothers part of Kahl. World want brothers dead. Kahl say no.\"", "DVeilRankThreeOne0840Kahl_en.ogg"], ["- Kahl: \"Kahl 'developed' eyes. Kahl know how you see brothers. How Captains and Queens see brothers. 'Honor'. 'Duty'. 'Glory'. Trick. All trick. Grineer die so Captains and Queens... even Orokin... do not. Kahl say to them: from now on do own dying. Brothers help.\"", "DVeilRankThreeOne0860Kahl_en.ogg"], ["- Kahl: \"Blue Girl. Kahl got question.\"", "DVeilRankThreeTwo0880Kahl_en.ogg"], ["- Kahl: \"Chipper and Horrek and Kahl tell stories. You not here, but you still part of camp. So, Kahl say it your turn. What worst fight you ever been in?\"", "DVeilRankThreeTwo0900Kahl_en.ogg"], ["- Kahl: \"Cooool.\"", "DVeilRankThreeTwo0920Kahl_en.ogg"]]},
  {"path": ["Communications", "Rank 5 - Home"], "idle": false, "lines": [["- Kahl: \"Kahl and brothers not what Orokin lady expected. You respect Kahl and brothers. You look at own family differently. Feel lonely. Kahl have family and you have... Kahl not know.\"", "DVeilRankFourOne0940Kahl_en.ogg"], ["- Kahl: \"It okay.\"", "DVeilRankFourOne0942Kahl_en.ogg"], ["- Kahl: \"Kahl self-made man.\"", "DVeilRankFourOne0960Kahl_en.ogg"], ["- Kahl: \"Blue girl. You do science stuff. Right?\"", "DVeilRankFourTwo0970Kahl_en.ogg"], ["- Kahl: \"Kahl want be smarter.\"", "DVeilRankFourTwo0990Kahl_en.ogg"], ["- Kahl: \"Kahl know you can. Kahl look forward to talk science together soon.\"", "DVeilRankFourTwo1010Kahl_en.ogg"], ["- Kahl: \"Those genestamps. Record how we made. Record how we die.\"", "DVeilRankFourThree1030Kahl_en.ogg"], ["- Kahl: \"Hmm. Queens put genestamp in machine. Next time brothers come out better. Kahl remember Brothers his way.\"", "DVeilRankFourThree1050Kahl_en.ogg"], ["- Kahl: \"Kahl One Seven Five on-station.\"", "DVeilRankFourFour1070Kahl_en.ogg"], ["- Kahl: \"Grineer never dream.\"", "DVeilRankFourFour1090Kahl_en.ogg"], ["- Kahl: \"You sleep. Kahl keep watch.\"", "DVeilRankFourFour1110Kahl_en.ogg"], ["- Kahl: \"Blue girl! Hai-Luk bring package! Kahl got fish you sent from Deimos!\"", "DVeilRankFourFive1120Kahl_en.ogg"], ["- Kahl: \"Oh, it very ugly. Kahl love it.\"", "DVeilRankFourFive1140Kahl_en.ogg"], ["- Kahl: \"Kahl see pretty bug today. Body like blue metal. Wing like glass. Fly right down and sit on Kahl hand. Kahl look right into little bug eyes.\"", "DVeilRankFourSix1160Kahl_en.ogg"], ["- Kahl: \"Bug... sting Kahl.\"", "DVeilRankFourSix1180Kahl_en.ogg"], ["- Kahl: \"Kahl not kill it. Not bug fault. Kahl big, bug little. Next time bug know.\"", "DVeilRankFourSix1200Kahl_en.ogg"], ["- Kahl: \"Blue Girl. Who is 'Nora'?\"", "DVeilRankFourSeven1210Kahl_en.ogg"], ["- Kahl: \"Huh. She sound like she know Kahl, but Kahl never see her. Sound like angel.\"", "DVeilRankFourSeven1230Kahl_en.ogg"], ["- Kahl: \"Hm. Maybe Blue Girl got wrong heroes.\"", "DVeilRankFourSeven1250Kahl_en.ogg"], ["- Kahl: \"Many animals on Plains. Condroc and Kuaka, and Kavat. Used to shoot because they got in way. Now Horrek leave food out.\"", "DVeilRankFourEight1260Kahl_en.ogg"], ["- Kahl: \"Maybe Kahl tame some. Bring home.\"", "DVeilRankFourEight1280Kahl_en.ogg"], ["- Kahl: \"Blue Girl. Camp need supply of Thrax Toxin in case Plague Star fall here.\"", "DVeilRankFourNine1300Kahl_en.ogg"], ["- Kahl: \"Plague Star. Big ball of Infested. Make everything Infested all over. Stink bad!\"", "DVeilRankFourNine1320Kahl_en.ogg"], ["- Kahl: \"Huh. You can smell from all way over there?\"", "DVeilRankFourNine1340Kahl_en.ogg"], ["- Kahl: \"Steel Meridian too big. Worms see them coming. Kahl work better like this. Little group. Like Kubrow pack.\"", "DVeilRankFourTen1360Kahl_en.ogg"], ["- Kahl: \"Blue Girl got something more important to do?\"", "DVeilRankFourTen1380Kahl_en.ogg"]]},
  {"path": ["Veilbreaker Device"], "idle": false, "lines": [["- Kahl: \"Used to be an EMP ram. Kahl change.\"", "DVeilInteract0300Kahl_en.ogg"], ["- Kahl: \"This 'Veilbreaker'. Not supposed to kill.\"", "DVeilInteract0320Kahl_en.ogg"], ["- Kahl: \"How many Grineer Blue Girl know?\"", "DVeilInteract0340Kahl_en.ogg"]]},
  {"path": ["Rank-up", "Rank 2 - Encampment"], "idle": false, "lines": [["- Kahl: \"Kahl new brother Sol-ar-is. That him there. Kahl find stuff, Chipper hand stuff out. Chipper tough like Grineer, but... not as smart. Chipper cut off own arms, leg head. Over there good place for Chipper.\"", "DVeilRankOne0390Kahl_en.ogg"]]},
  {"path": ["Rank-up", "Rank 3 - Fort"], "idle": false, "lines": [["- Kahl: \"Camp still small, but we grow. Each day more brothers freed. Each day Kahl family grow stronger. Blue Girl family turn away Kahl. So Kahl grateful to Tenno. For new home. Mm. Brothers, too. Make Tenno proud.\"", "DVeilRankTwo0400Kahl_en.ogg"]]},
  {"path": ["Rank-up", "Rank 4 - Settlement"], "idle": false, "lines": [["- Kahl: \"Camp strong... but can be stronger. Kahl and Blue Girl will free even more brothers. Strong boy brothers and smart girl brothers. Kahl and Blue Girl good team. Narmer scared. Blue Girl excited. Say day of reckoning be fun party. No be party. For brothers... new life. For Narmer... end of world.\"", "DVeilRankThree0410Kahl_en.ogg"]]},
  {"path": ["Rank-up", "Rank 5 - Home"], "idle": false, "lines": [["- Kahl: \"Vay Hek say Ostron Kahl enemy. But Ostron not enemy. Queens say Tenno is monster. But Tenno not monster. They lie. Narmer is enemy. Pazuul is monster. And Vay Hek. Vay Hek scared of Pazuul. Queens hide in fortress. Cowards. And Tenno? Tenno not coward. Tenno not hide. Tenno fight Archons. Tenno give home. To brothers. Tenno is friend. Tenno is brother.\"", "DVeilRankFour0420Kahl_en.ogg"]]},
  {"path": ["Break Narmer", "Killing Enemies"], "idle": false, "lines": [["- \"Night night.\"", "DVeilKahlEnemyKill0010Kahl_en.ogg"], ["- \"Skoom!\"", "DVeilKahlEnemyKill0020Kahl_en.ogg"], ["- \"One less!\"", "DVeilKahlEnemyKill0030Kahl_en.ogg"], ["- (laughs) \"Another!\"", "DVeilKahlEnemyKill0040Kahl_en.ogg"], ["- \"Dead now!\"", "DVeilKahlEnemyKill0050Kahl_en.ogg"], ["- \"Stay down!\"", "DVeilKahlEnemyKill0060Kahl_en.ogg"], ["- \"Ha, easy kill!\"", "DVeilKahlEnemyKill0070Kahl_en.ogg"], ["- (spits)", "DVeilKahlEnemyKill0080Kahl_en.ogg"], ["- \"You done!\"", "DVeilKahlEnemyKill0090Kahl_en.ogg"], ["- \"You dead already!\"", "DVeilKahlEnemyKill0100Kahl_en.ogg"], ["- \"For my brothers!\"", "DVeilKahlEnemyKill0110Kahl_en.ogg"], ["- \"Weakling!\"", "DVeilKahlEnemyKill0120Kahl_en.ogg"], ["- \"Fah-sukh-ung skoom!\"", "DVeilKahlEnemyKill0130Kahl_en.ogg"], ["- \"Kahl teach you good!\"", "DVeilKahlEnemyKill0140Kahl_en.ogg"], ["- \"No get back up!\"", "DVeilKahlEnemyKill0150Kahl_en.ogg"], ["- \"Scrape you off boot.\"", "BbVeilKahlEnemyKillKahl1040_en.ogg"], ["- \"Kahl make mess.\"", "BbVeilKahlEnemyKillKahl1050_en.ogg"], ["- \"Call that a fight?\"", "BbVeilKahlEnemyKillKahl1060_en.ogg"], ["- \"Good kill.\"", "BbVeilKahlEnemyKillKahl1070_en.ogg"], ["- \"Gutora!\" - \"Bitch!\"", "BbVeilKahlEnemyKillKahl1080_en.ogg"], ["- \"You fight like tube runt.\"", "BbVeilKahlEnemyKillKahl1090_en.ogg"], ["- \"That Grineer mercy.\"", "BbVeilKahlEnemyKillKahl1100_en.ogg"], ["- \"Clean kill.\"", "BbVeilKahlEnemyKillKahl1110_en.ogg"], ["- \"You all done?\"", "BbVeilKahlEnemyKillKahl1120_en.ogg"], ["- \"Kahl finish you.\"", "BbVeilKahlEnemyKillKahl1130_en.ogg"], ["- \"Target dead.\"", "BbVeilKahlEnemyKillKahl1140_en.ogg"]]},
  {"path": ["Break Narmer", "Enemy Spotted"], "idle": false, "lines": [["- \"Kahl see you.\"", "DVeilKahlEnemySpot0160Kahl_en.ogg"], ["- \"Kahl mark target.\"", "DVeilKahlEnemySpot0170Kahl_en.ogg"], ["- \"You next.\"", "DVeilKahlEnemySpot0180Kahl_en.ogg"], ["- \"Got one.\"", "DVeilKahlEnemySpot0190Kahl_en.ogg"], ["- \"More.\"", "DVeilKahlEnemySpot0200Kahl_en.ogg"], ["- \"New target.\"", "DVeilKahlEnemySpot0210Kahl_en.ogg"], ["- \"More ahead.\"", "DVeilKahlEnemySpot0220Kahl_en.ogg"], ["- \"That one moving.\"", "DVeilKahlEnemySpot0230Kahl_en.ogg"], ["- \"Got target.\"", "DVeilKahlEnemySpot0240Kahl_en.ogg"], ["- \"Not clear here.\"", "DVeilKahlEnemySpot0250Kahl_en.ogg"], ["- \"Tagging.\"", "DVeilKahlEnemySpot0260Kahl_en.ogg"], ["- \"Garkot spotter.\" - \"Target spotted.\"", "DVeilKahlEnemySpot0270Kahl_en.ogg"], ["- \"Orre klegra!\" - \"Over there!\"", "DVeilKahlEnemySpot0280Kahl_en.ogg"], ["- \"Garkot akkruhurer.\" - \"Target acquired.\"", "DVeilKahlEnemySpot0290Kahl_en.ogg"], ["- \"Found more.\"", "DVeilKahlEnemySpot0300Kahl_en.ogg"]]},
  {"path": ["Break Narmer", "Throwing Grenade"], "idle": false, "lines": [["- \"Boom out!\"", "DVeilKahlAbility0310Kahl_en.ogg"], ["- \"Fire!\"", "DVeilKahlAbility0320Kahl_en.ogg"], ["- \"Take cover!\"", "DVeilKahlAbility0330Kahl_en.ogg"], ["- \"Get down!\"", "DVeilKahlAbility0340Kahl_en.ogg"], ["- \"Eat this!\"", "DVeilKahlAbility0350Kahl_en.ogg"], ["- \"For the brothers!\"", "DVeilKahlAbility0360Kahl_en.ogg"], ["- \"You burn!\"", "DVeilKahlAbility0370Kahl_en.ogg"], ["- \"Khus gar!\" - \"Kill you!\"", "DVeilKahlAbility0380Kahl_en.ogg"], ["- \"This for you!\"", "DVeilKahlAbility0390Kahl_en.ogg"], ["- \"Thermo!\"", "DVeilKahlAbility0400Kahl_en.ogg"], ["- \"Burn you out!\"", "DVeilKahlAbility0410Kahl_en.ogg"], ["- \"Grineer surprise!\"", "DVeilKahlAbility0420Kahl_en.ogg"], ["- \"Head up!\"", "DVeilKahlAbility0430Kahl_en.ogg"], ["- \"Grenade out!\"", "DVeilKahlAbility0440Kahl_en.ogg"], ["- \"Fire in hole!\"", "DVeilKahlAbility0450Kahl_en.ogg"]]},
  {"path": ["Break Narmer", "Under Fire"], "idle": false, "lines": [["- \"Kahl not stop!\"", "DVeilKahlUnderFire0460Kahl_en.ogg"], ["- \"That all you got?\"", "DVeilKahlUnderFire0470Kahl_en.ogg"], ["- \"They hit Kahl hard.\"", "DVeilKahlUnderFire0480Kahl_en.ogg"], ["- \"Need cover!\"", "DVeilKahlUnderFire0490Kahl_en.ogg"], ["- \"Flesh wound.\"", "DVeilKahlUnderFire0500Kahl_en.ogg"], ["- \"Kahl bleed.\"", "DVeilKahlUnderFire0510Kahl_en.ogg"], ["- \"Armor not hold.\"", "DVeilKahlUnderFire0520Kahl_en.ogg"], ["- \"More wound, more scar!\"", "DVeilKahlUnderFire0530Kahl_en.ogg"], ["- \"Push… through… pain.\"", "DVeilKahlUnderFire0540Kahl_en.ogg"], ["- \"Need Blunt!\"", "DVeilKahlUnderFire0550Kahl_en.ogg"], ["- \"Under fire!\"", "DVeilKahlUnderFire0560Kahl_en.ogg"], ["- \"Getting hit!\"", "DVeilKahlUnderFire0570Kahl_en.ogg"], ["- \"Kahl taking fire!\"", "DVeilKahlUnderFire0580Kahl_en.ogg"], ["- \"Kahl not take this forever!\"", "DVeilKahlUnderFire0590Kahl_en.ogg"], ["- \"Kahl feel that!\"", "DVeilKahlUnderFire0600Kahl_en.ogg"]]},
  {"path": ["Break Narmer", "Near Death"], "idle": false, "lines": [["- \"Must… fight… on.\"", "DVeilKahlNearDeath0760Kahl_en.ogg"], ["- \"Kahl… won't stop.\"", "DVeilKahlNearDeath0770Kahl_en.ogg"], ["- \"For… for the brothers!\"", "DVeilKahlNearDeath0780Kahl_en.ogg"], ["- \"Not… done… yet!\"", "DVeilKahlNearDeath0790Kahl_en.ogg"], ["- \"Not… die… so… easy.\"", "DVeilKahlNearDeath0800Kahl_en.ogg"], ["- \"Been… through worse.\"", "DVeilKahlNearDeath0810Kahl_en.ogg"], ["- \"Kahl… keep… going.\"", "DVeilKahlNearDeath0820Kahl_en.ogg"], ["- \"Brothers… need… Kahl.\"", "DVeilKahlNearDeath0830Kahl_en.ogg"], ["- \"Everything… going… dark.\"", "DVeilKahlNearDeath0840Kahl_en.ogg"], ["- \"You… not break… Kahl.\"", "DVeilKahlNearDeath0850Kahl_en.ogg"], ["- \"You… think… Kahl… done?\"", "DVeilKahlNearDeath0860Kahl_en.ogg"], ["- \"Brothers… wait for Kahl!\"", "DVeilKahlNearDeath0870Kahl_en.ogg"], ["- \"Not now, gutora death.\"", "DVeilKahlNearDeath0880Kahl_en.ogg"], ["- \"Kahl in bad shape.\"", "DVeilKahlNearDeath0890Kahl_en.ogg"], ["- \"Kahl blood all over.\"", "DVeilKahlNearDeath0900Kahl_en.ogg"]]},
  {"path": ["Break Narmer", "Reviving Allies"], "idle": false, "lines": [["- \"Brother, get up.\"", "DVeilKahlRevive0910Kahl_en.ogg"], ["- \"Not your time.\"", "DVeilKahlRevive0920Kahl_en.ogg"], ["- \"Not done killing.\"", "DVeilKahlRevive0930Kahl_en.ogg"], ["- \"I know you still have fight, brother.\"", "DVeilKahlRevive0940Kahl_en.ogg"], ["- \"Not yet, brother.\"", "DVeilKahlRevive0950Kahl_en.ogg"], ["- \"Get up. Need your help.\"", "DVeilKahlRevive0960Kahl_en.ogg"]]},
