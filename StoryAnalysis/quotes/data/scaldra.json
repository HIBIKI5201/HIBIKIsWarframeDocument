  {"path": [], "idle": false, "lines": [["Dialogue of the Scaldra.", null]]},
  {"path": ["Scaldra Jaeger", "Idle"], "idle": true, "lines": [["- \"(?)\"", "LasrianEnemyAIdleA.ogg"], ["- \"(?)\"", "LasrianEnemyAIdleB.ogg"], ["- \"Copy that. Status: nothing in sector.\"", "LasrianEnemyAIdleC.ogg"], ["- \"All nearby units are to protect the Doktor.\"", "LasrianEnemyAIdleD.ogg"], ["- \"Nada. Yeah, done. Took off.\"", "LasrianEnemyAIdleE.ogg"], ["- \"(?)\"", "LasrianEnemyAIdleF.ogg"], ["- \"(?)\"", "LasrianEnemyAIdleG.ogg"], ["- \"Yeah, yeah, and I'll think about packing the other, over.\"", "LasrianEnemyAIdleH.ogg"]]},
  {"path": ["Scaldra Jaeger", "Searching"], "idle": false, "lines": [["- \"Detected. Contact. Detected.\"", "LasrianEnemyASearchingA.ogg"], ["- \"Confirmed. Contact confirmed.\"", "LasrianEnemyASearchingB.ogg"], ["- \"What? Get there and find out. Get it done quietly.\"", "LasrianEnemyASearchingC.ogg"], ["- \"Did you see that? Get there and just hope it's safe.\"", "LasrianEnemyASearchingD.ogg"], ["- \"Hostile detected.\"", "LasrianEnemyASearchingE.ogg"], ["- \"Did you see that? Get searching for combustors. Get to attacking targets, too.\"", "LasrianEnemyASearchingF.ogg"], ["- \"(?)\"", "LasrianEnemyASearchingG.ogg"], ["- \"Can somebody get that? It's about time to send it a bullet.\"", "LasrianEnemyASearchingH.ogg"]]},
  {"path": ["Scaldra Jaeger", "Player Spotted"], "idle": false, "lines": [["- \"Detected! Come on, stay under! Take 'em down!\"", "LasrianEnemyAPlayerSpottedAttackA.ogg"], ["- \"Cover me!\"", "LasrianEnemyAPlayerSpottedAttackB.ogg"], ["- \"Go ahead! Kill them now!\"", "LasrianEnemyAPlayerSpottedAttackC.ogg"], ["- \"Now, now! Target spotted!\"", "LasrianEnemyAPlayerSpottedAttackD.ogg"], ["- \"Put them under the ground! Go!\"", "LasrianEnemyAPlayerSpottedAttackE.ogg"], ["- \"Go, go, go, target in sight!\"", "LasrianEnemyAPlayerSpottedAttackF.ogg"], ["- \"Attack! Go and take them down!\"", "LasrianEnemyAPlayerSpottedAttackG.ogg"], ["- \"Get it done and done!\"", "LasrianEnemyAPlayerSpottedAttackH.ogg"], ["- \"Get them, get them, I want them dead!\"", "LasrianEnemyAPlayerSpottedAttackI.ogg"], ["- \"They're... they're the horrors!\"", "LasrianEnemyAPlayerSpottedAttackJ.ogg"], ["- \"(?)\"", "LasrianEnemyAPlayerSpottedAttackK.ogg"], ["- \"(?)\"", "LasrianEnemyAPlayerSpottedAttackL.ogg"], ["- \"(?)\"", "LasrianEnemyAPlayerSpottedAttackM.ogg"], ["- \"Come in! Target detected! Come in!\"", "LasrianEnemyAPlayerSpottedAttackN.ogg"], ["- \"Hostile detected! Attack!\"", "LasrianEnemyAPlayerSpottedAttackO.ogg"], ["- \"(?)\"", "LasrianEnemyAPlayerSpottedAttackP.ogg"]]},
  {"path": ["Scaldra Jaeger", "Death"], "idle": false, "lines": [["- \"Come on... come on!\"", "LasrianEnemyADeathD.ogg"], ["- \"Help me!\"", "LasrianEnemyADeathF.ogg"], ["- \"Oh... no!\"", "LasrianEnemyADeathG.ogg"]]},
  {"path": ["Scaldra Barbican", "Idle"], "idle": true, "lines": [["- \"They're coming. Yeah. It's done.\"", "LasrianEnemyBIdleA.ogg"], ["- \"(?)\"", "LasrianEnemyBIdleB.ogg"], ["- (laughs) \"So good.\"", "LasrianEnemyBIdleC.ogg"], ["- \"(?)\"", "LasrianEnemyBIdleD.ogg"], ["- (laughs) \"To me.\"", "LasrianEnemyBIdleE.ogg"], ["- (laughs) \"Come on, come on!\"", "LasrianEnemyBIdleF.ogg"], ["- \"(?)\"", "LasrianEnemyBIdleG.ogg"], ["- \"(?)\"", "LasrianEnemyBIdleH.ogg"]]},
  {"path": ["Scaldra Barbican", "Search"], "idle": false, "lines": [["- \"(?)\"", "LasrianEnemyBSearchingA.ogg"], ["- \"(?)\"", "LasrianEnemyBSearchingB.ogg"], ["- \"Come, come, come! Target spotted.\"", "LasrianEnemyBSearchingC.ogg"], ["- \"(?)\"", "LasrianEnemyBSearchingD.ogg"], ["- \"Now, now, how about you come out, show yourself, yeah.\"", "LasrianEnemyBSearchingE.ogg"], ["- \"\"", "LasrianEnemyBSearchingF.ogg"], ["- \"Contact. To me, now. Yeah, they're out.\"", "LasrianEnemyBSearchingG.ogg"], ["- \"\"", "LasrianEnemyBSearchingH.ogg"]]},
  {"path": ["Scaldra Barbican", "Player Spotted"], "idle": false, "lines": [["- \"They're coming here. Hold position.\"", "LasrianEnemyBPlayerSpottedAttackA.ogg"], ["- \"Come! Hold the area here!\"", "LasrianEnemyBPlayerSpottedAttackB.ogg"], ["- \"(?)\"", "LasrianEnemyBPlayerSpottedAttackC.ogg"], ["- \"(?)\"", "LasrianEnemyBPlayerSpottedAttackD.ogg"], ["- \"Yeah, they're on me!\"", "LasrianEnemyBPlayerSpottedAttackE.ogg"], ["- \"Come here! Keep them off!\"", "LasrianEnemyBPlayerSpottedAttackF.ogg"], ["- \"Defend here! Stop them!\"", "LasrianEnemyBPlayerSpottedAttackG.ogg"], ["- \"(?)\"", "LasrianEnemyBPlayerSpottedAttackH.ogg"], ["- \"Come and get it!\" (laughs)", "LasrianEnemyBPlayerSpottedAttackI.ogg"], ["- \"(?)\"", "LasrianEnemyBPlayerSpottedAttackJ.ogg"], ["- \"(?)\"", "LasrianEnemyBPlayerSpottedAttackK.ogg"], ["- (laughs) \"Kill!\"", "LasrianEnemyBPlayerSpottedAttackL.ogg"], ["- \"They're coming!\"", "LasrianEnemyBPlayerSpottedAttackM.ogg"], ["- \"Come and hold control!\"", "LasrianEnemyBPlayerSpottedAttackN.ogg"], ["- \"They are coming!\"", "LasrianEnemyBPlayerSpottedAttackO.ogg"], ["- \"Come here and help me!\"", "LasrianEnemyBPlayerSpottedAttackP.ogg"]]},
  {"path": ["Scaldra Barbican", "Death"], "idle": false, "lines": [["- \"Oh, come on!\"", "LasrianEnemyBDeathA.ogg"], ["- \"No... oh no...\"", "LasrianEnemyBDeathB.ogg"], ["- \"Oh no!\"", "LasrianEnemyBDeathC.ogg"]]},
  {"path": ["Scaldra Flayer", "Idle"], "idle": true, "lines": [["- \"Reporting all clear.\"", "LasrianEnemyCIdleA.ogg"], ["- \"(?)\"", "LasrianEnemyCIdleB.ogg"], ["- \"(?)\"", "LasrianEnemyCIdleC.ogg"], ["- \"(?)\"", "LasrianEnemyCIdleD.ogg"], ["- \"(?)\"", "LasrianEnemyCIdleE.ogg"], ["- \"(?)\"", "LasrianEnemyCIdleF.ogg"], ["- \"(?)\"", "LasrianEnemyCIdleG.ogg"], ["- \"No.\"", "LasrianEnemyCIdleH.ogg"]]},
  {"path": ["Scaldra Flayer", "Search"], "idle": false, "lines": [["- \"Now get out of your cover!\"", "LasrianEnemyCSearchingA.ogg"], ["- \"(?)\"", "LasrianEnemyCSearchingB.ogg"], ["- \"(?)\"", "LasrianEnemyCSearchingC.ogg"], ["- \"(?)\"", "LasrianEnemyCSearchingD.ogg"], ["- \"(?)\"", "LasrianEnemyCSearchingE.ogg"], ["- \"Ah ha!\"", "LasrianEnemyCSearchingF.ogg"], ["- \"(?)\"", "LasrianEnemyCSearchingG.ogg"], ["- \"(?)\"", "LasrianEnemyCSearchingH.ogg"]]},
  {"path": ["Scaldra Flayer", "Player Spotted"], "idle": false, "lines": [["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackA.ogg"], ["- \"Charge them!\"", "LasrianEnemyCPlayerSpottedAttackB.ogg"], ["- \"Attack!\"", "LasrianEnemyCPlayerSpottedAttackC.ogg"], ["- \"Shoot 'til they die!\"", "LasrianEnemyCPlayerSpottedAttackD.ogg"], ["- \"Go, shoot 'til they die!\"", "LasrianEnemyCPlayerSpottedAttackE.ogg"], ["- \"Alright, gun them down!\"", "LasrianEnemyCPlayerSpottedAttackF.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackG.ogg"], ["- \"Gun them, now!\"", "LasrianEnemyCPlayerSpottedAttackH.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackI.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackJ.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackK.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackL.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackM.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackN.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackO.ogg"], ["- \"(?)\"", "LasrianEnemyCPlayerSpottedAttackP.ogg"], ["**Ability Used**", "LasrianEnemyCAbilityUsedA.ogg"]]},
  {"path": ["Scaldra Screamer", "Spawning"], "idle": false, "lines": [["- \"You. You. You. You. Going dowwnnnnnnnn. Ahhhhhh.\"", "DScreamerAttacks0560Screamer_en.ogg"], ["- \"[Take him, ouuuuuut.] Techrot, techrot, techrot, FILTH. AHHHHHHHHH.\"", "DScreamerAttacks0570Screamer_en.ogg"], ["- (screaming)", "DScreamerAttacks0580Screamer_en.ogg"], ["- \"You're going to DIE. DIE. DIE. DIE. DEAD.\"", "DScreamerAttacks0590Screamer_en.ogg"], ["- \"Scaldra is my LIFE. My service. My EVERYTHING. YEAAAHH.\"", "DScreamerAttacks0600Screamer_en.ogg"], ["- \"FORRRRR PUUUURITEEEEEE. YEAH.\"", "DScreamerAttacks0610Screamer_en.ogg"], ["- \"Smash it, shake it. Kill it, break it. Crush it, take it.\"", "DScreamerAttacks0620Screamer_en.ogg"], ["- \"Ready or not, here I COME.\"", "DScreamerAttacks0630Screamer_en.ogg"], ["- \"Techrot bleeds for me!\"", "DScreamerAttacks0640Screamer_en.ogg"], ["- \"Pray for a purge. Pray for a purge. Pray for a purge.\"", "DScreamerAttacks0650Screamer_en.ogg"], ["- \"Black sun. Blood moon. Oceans of pain are here for yooooouuuu!!!!!\"", "DScreamerAttacks0660Screamer_en.ogg"], ["- \"Ripped sky. Tortured earth. Nothing born and everything dies.\"", "DScreamerAttacks0670Screamer_en.ogg"], ["- \"I am your deafening.\"", "DScreamerAttacks0680Screamer_en.ogg"], ["- \"Abolish the abomination. Kill its creation.\"", "DScreamerAttacks0690Screamer_en.ogg"], ["- \"Heretic… I am your salvation.\"", "DScreamerAttacks0700Screamer_en.ogg"]]},
  {"path": ["Scaldra Screamer", "Self-Destructing"], "idle": false, "lines": [["- (laughing)", "LasrianScreamerSelfDestructA.ogg"], ["- (laughing)", "LasrianScreamerSelfDestructB.ogg"], ["- (laughing)", "LasrianScreamerSelfDestructC.ogg"], ["- (laughing)", "LasrianScreamerSelfDestructD.ogg"], ["- (laughing)", "LasrianScreamerSelfDestructE.ogg"], ["- (laughing)", "LasrianScreamerSelfDestructF.ogg"]]},
  {"path": ["Major Neci Rusalka"], "idle": false, "lines": [["**TennoCon 2024 Demo**", null], ["- \"A slug dares to show its face at night?\"", "DStreets0210Rusalka_en.ogg"], ["- \"Didn't the bastard Doktor warn you?\"", "DStreets0211Rusalka_en.ogg"], ["- \"I've an order.\"", "DStreets0212Rusalka_en.ogg"], ["- \"Kill. On. Sight.\"", "DStreets0213Rusalka_en.ogg"], ["- \"Pity. We could have been allies. My Scaldra: Put that thing down!\"", "DStreets0220Rusalka_en.ogg"], ["- \"Meet the co-star of your grand finale. An H-04 Efervon Tank. Enjoy.\"", "DStreets0230Rusalka_en.ogg"], ["- \"Have it your way. By this time next year, nothing will remain of you slugs.\"", "DStreets0231Rusalka_en.ogg"], ["- \"Viktor? Drop them in. NOW.\"", "DStreets0245Rusalka_en.ogg"], ["**Announcements**", null], ["- \"All Scaldra to engage in Extermination Protocol.\"", null], ["**1999 Demo**", null], ["- \"You slugs still don't understand. This is a numbers game. Your blades will go dull before I run out of reinforcements.\"", "DRusalkaTauntEarly0150Rusalka_en.ogg"], ["- \"You puny slugs. So close to the ground you can't see the big picture. Chaos followed Doktor Entrati, but within chaos is opportunity. Opportunity I will seize, no matter how hard you squirm.\"", "DRusalkaTauntEarly0170Rusalka_en.ogg"], ["- \"Arthur. That is your name, is it not? Do you know what I do to slugs, Arthur? I grind them beneath my heel.\"", "DRusalkaTauntEarly0190Rusalka_en.ogg"], ["- \"You should not, even for a second, think you have won something today. Scaldra is unending.\"", "DRusalkaTauntLater0270Rusalka_en.ogg"], ["- \"You are nothing but a distraction. A plaything! When you grow lazy, and you will, I will find you. It will not be a pleasurable experience.\"", "DRusalkaTauntLater0290Rusalka_en.ogg"]]},
  {"path": ["Lieutenant Viktor Vodyanoi", "Summoning Stormfall"], "idle": false, "lines": [["- \"Stormfall, do your thing. Make it brutal or don't bother.\"", "DParaInbound0010Viktor_en.ogg"], ["- \"Enough. Stormfall, may Sol guide you to greatness.\"", "DParaInbound0020Viktor_en.ogg"], ["- \"Stormfall. Deploy. Give our lady Lua something to weep over tonight.\"", "DParaInbound0030Viktor_en.ogg"], ["- \"You are trying my patience with these antics. Stormfall troops, make these heathens go away.\"", "DParaInbound0040Viktor_en.ogg"], ["- \"Hex, I keep kicking you OVER and OVER again like a big, dumb, dead horse and you DON'T learn and I'm tired! I'M SO! TIRED!! Stormfall, please! Save me the bother!\"", "DParaInbound0050Viktor_en.ogg"], ["- \"Huh. It's the Hex again. Really? Ok. I want you to ask yourself: cou-could this have been a Paratrooper thing? Could Stormfall deal with them? Yeah? Ok.\"", "DParaInbound0060Viktor_en.ogg"], ["- \"These things are no better than pond scum. Unclean and unholy. Stormfall - purge them from my city, will you?\"", "DParaInbound0070Viktor_en.ogg"], ["- \"Why do you find it so difficult to get rid of these... these slugs?! Throw more troops at them. Shall I write it on your hand?\"", "DParaInbound0080Viktor_en.ogg"], ["- \"Is there a unit ready? Good. Deploy.\"", "DParaInbound0090Viktor_en.ogg"], ["- \"Once again my hour of meditation has been disturbed. My sancta sanctorum has been decimated. You will suffer for this, in a million future lives of surpassing wretchedness! Stormfall units, descend.\"", "DParaInbound0100Viktor_en.ogg"], ["- \"Stormfall unit, my children, as you prepare to descend from on high, take a moment to read the Prayer to Sol which you can of course find on your Credo card. We are not dying in a state of sin today.\"", "DParaInbound0110Viktor_en.ogg"], ["- \"Stormfall, have faith that your sacrifice today in the name of Sol and Scaldra will not be in vain. A place has surely been prepared for you in the Hall of Heroes.\"", "DParaInbound0120Viktor_en.ogg"], ["- \"Stormfall, you're going up against the most dangerous breed of Techrot: The Hex. Best of luck to you. Good hunting.\"", "DParaInbound0130Viktor_en.ogg"], ["- \"I have explained it to you until I am bleeding from the eyes. The answer is right there in front of your gawking moon-cheese of a face! SHOOT THEM! UNTIL. THEY. STAY. DEAD!!\"", "DParaInbound0140Viktor_en.ogg"], ["- \"Hex... why do you insist on refusing your medicine? Has it escaped to you that I command a literal army?! Stormfall Paratroopers engage.\"", "DParaInbound0150Viktor_en.ogg"], ["- \"Citizens! Fear not. We have the situation under control, as I speak, the planes you hear above your head are delivering elite troops to neutralize The Hex. Rest assured, this criminal organization will be eliminated. With extreme prejudice.\"", "DParaInbound0160Viktor_en.ogg"]]}
 ]
}
