  {"path": ["Lua"], "idle": false, "lines": [["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00100VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00140VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Hey, kiddo!\"", "DChimeraIntro0010VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00150VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00160VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00170VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00180VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00190VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00200VoidEchoA_en_new.ogg"], ["- The Man in The Wall: \"Psst... Hey.\"", "DChimeraIntro00210VoidEchoA_en_new.ogg"], ["- Lotus: \"I am not who you think I am.\"", "DChimeraIntro0050Lotus_en.ogg"], ["- Ballas: \"But of course, you are. Imprisoned, just as she was.\"", "DChimeraIntro0060Ballas_en.ogg"], ["- The Man in The Wall: \"Haha!\"", "DChimeraIntro00220VoidEchoB_en_new.ogg"]]},
  {"path": ["The Sentient Chamber"], "idle": false, "lines": [["- Ballas: \"No... No...\"", "DChimeraBallasCell0070Ballas_en.ogg"], ["- Ballas: \"My beauty, my grace, my humanity--\"", "DChimeraBallasCell0080Ballas_en.ogg"], ["- Ballas: \"H-hello? No. No hope.\"", "DChimeraBallasCell0090Ballas_en.ogg"], ["- Ballas: (grunts)", "DChimeraBallasCell00130Ballas_en.ogg"], ["- Ballas: \"Only suffering under her eye.\"", "DChimeraBallasCell0100Ballas_en.ogg"], ["- Ballas: \"That she sees... she punishes!\"", "DChimeraBallasCell0101Ballas_en.ogg"], ["- Ballas: \"But... she gave me the gift of life!\"", "DChimeraBallasCell0110Ballas_en.ogg"], ["- Ballas: \"Why would I betray her?\"", "DChimeraBallasCell0111Ballas_en.ogg"], ["- Ballas: \"Fool! This... this is no gift!\"", "DChimeraBallasCell0120Ballas_en.ogg"], ["- Ballas: \"She stole my death! My perfect death.\"", "DChimeraBallasCell0121Ballas_en.ogg"], ["- Ballas: \"Such is her power... over me. Over the devil!\"", "DChimeraBallasCell0122Ballas_en.ogg"], ["- Ballas: \"We saw what we wanted, those devils and I.\"", "DChimeraBallasEnd0190Ballas_en.ogg"], ["- Ballas: \"A lover... a mother! But now I know.\"", "DChimeraBallasEnd0191Ballas_en.ogg"], ["- Ballas: \"She is neither. She's a hawk - calling with sparrow's song.\"", "DChimeraBallasEnd0192Ballas_en.ogg"], ["- Ballas: \"A viper, blending into wood.\"", "DChimeraBallasEnd0193Ballas_en.ogg"], ["- Ballas: \"And her venom... spreads not into flesh, but into your heart.\"", "DChimeraBallasEnd0200Ballas_en.ogg"], ["- Ballas: \"Those devils! What has their great awakening accomplished - but the destruction of potential allies?\"", "DChimeraBallasEnd0201Ballas_en.ogg"], ["- Ballas: \"Don't they see?\"", "DChimeraBallasEnd0202Ballas_en.ogg"], ["- Ballas: \"Love must die--\"", "DChimeraBallasEnd0210Ballas_en.ogg"], ["- Ballas: \"--As Margulis did... when I sent her to the Jade Light.\"", "DChimeraBallasEnd0220Ballas_en.ogg"], ["- Ballas: \"And the Lotus... just some cloud in the sky, just some shape they imagined.\"", "DChimeraBallasEnd0221Ballas_en.ogg"], ["- Ballas: \"Only the Sentient is real.\"", "DChimeraBallasEnd0222Ballas_en.ogg"], ["- Ballas: \"Only Natah.\"", "DChimeraBallasEnd0223Ballas_en.ogg"], ["**If Ballas spots the player**", null], ["- Ballas: \"Who-who's there?\"", "DChimeraBallasInt0130Ballas_en.ogg"], ["- Ballas: \"What? What is this?\"", "DChimeraBallasInt0140Ballas_en.ogg"], ["- Ballas: \"Oh? Is there someone...?\"", "DChimeraBallasInt0150Ballas_en.ogg"], ["- Ballas: \"Huh?\"", "DChimeraBallasInt00160Ballas_en.ogg"], ["- Ballas: \"Huh?\"", "DChimeraBallasInt00170Ballas_en.ogg"], ["- Ballas: \"Who?\"", "DChimeraBallasInt00180Ballas_en.ogg"], ["- Ballas: \"Huh?\"", "DChimeraBallasInt00190Ballas_en.ogg"], ["**If Ballas loses sight of the player**", null], ["- Ballas: \"Nothing, so...\"", "DChimeraBallasRes0160Ballas_en.ogg"], ["- Ballas: \"I'm just confused... huh...\"", "DChimeraBallasRes0170Ballas_en.ogg"], ["- Ballas: \"Only shadow... only shadow...\"", "DChimeraBallasRes0180Ballas_en.ogg"], ["- Ballas: \"Oh.\"", "DChimeraBallasRes00190Ballas_en.ogg"], ["- Ballas: \"Ok...\"", "DChimeraBallasRes00200Ballas_en.ogg"], ["- Ballas: \"Oh.\"", "DChimeraBallasRes00210Ballas_en.ogg"], ["- Ballas: \"Huh.\"", "DChimeraBallasRes00220Ballas_en.ogg"], ["**Paracesis finished building**", null], ["- Ballas: \"So... tell me, devil. Do you understand what must be done?\"", "DChimeraBallasEnd0230Ballas_en.ogg"], ["- Ballas: \"The Paracesis. The Sentient slayer... Hurry! Take this... the idea of it... it is the only way your war can end.\"", "DChimeraBallasEnd0240Ballas_en.ogg"], ["- Natah: \"Tenno... Tenno...\"", "DChimeraBallasEnd0250Natah_en.ogg"]]},
