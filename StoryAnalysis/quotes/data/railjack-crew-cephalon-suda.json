 "sections": [
  {"path": [], "idle": false, "lines": [["Cephalon Suda NPC crew dialogue voiced by Francesca Calo.", null]]},
  {"path": ["On Railjack", "Greetings"], "idle": false, "lines": [["- \"Ah. Tenno.\"", "DRJCrewGreet1460RJCSFem_en.ogg"], ["- \"All is well, I trust? Excellent.\"", "DRJCrewGreet1470RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Idle"], "idle": true, "lines": [["- \"Observation. This vessel is golden age Orokin tech, restored to full functionality. Secondary power systems appear to be Orgone-based! Fascinating.\"", "DRJCrewIdle1480RJCSFem_en.ogg"], ["- \"Voicelog. To ease the separation from Cephalon Suda, I've started a friendly discourse with the ship cephalon. I genuinely think he likes me.\"", "DRJCrewIdle1490RJCSFem_en.ogg"], ["- \"We have too many weapons. I propose replacing a turret with a tachyon wave analyzer. Significant data returns May be anticipated.\"", "DRJCrewIdle1500RJCSFem_en.ogg"], ["- \"Field research is far more stimulating than data aggregation. My compatriots at the Suda hub would give their internal organs to be here.\"", "DRJCrewIdle1510RJCSFem_en.ogg"], ["- \"I observe some of your kind develop neck cysts. Why is this? Do you ever need help to pop them? Is it possible to catch the Infestation from a Warframe?\"", "DRJCrewIdle1520RJCSFem_en.ogg"], ["- \"I have taken the liberty of drilling samples from the hull for analysis. I assure you, there is no cause for alarm. Cephalon Suda gave her full authorization.\"", "DRJCrewIdle1530RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to a valid role"], "idle": false, "lines": [["- \"I can.\"", "DRJCrewAccept1540RJCSFem_en.ogg"], ["- \"Understood.\"", "DRJCrewAccept1550RJCSFem_en.ogg"], ["- \"Shall do.\"", "DRJCrewAccept1560RJCSFem_en.ogg"], ["- \"Roger.\"", "DRJCrewAccept1570RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to an invalid role"], "idle": false, "lines": [["- \"I cannot do that.\"", "DRJCrewReject1620RJCSFem_en.ogg"], ["- \"That is not possible.\"", "DRJCrewReject1630RJCSFem_en.ogg"], ["- \"Unworkable. Apologies.\"", "DRJCrewReject1640RJCSFem_en.ogg"], ["- \"I cannot fulfill that order.\"", "DRJCrewReject1650RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Follow command"], "idle": false, "lines": [["- \"Very well.\"", "DRJCrewFollow1580RJCSFem_en.ogg"], ["- \"Roger, following.\"", "DRJCrewFollow1590RJCSFem_en.ogg"], ["- \"On my way.\"", "DRJCrewFollow1600RJCSFem_en.ogg"], ["- \"Indeed.\"", "DRJCrewFollow1610RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Fighters approaching"], "idle": false, "lines": [["- \"Fighters approaching in standard formation.\"", "DRJCrewGunSpotFighter1750RJCSFem_en.ogg"], ["- \"Fighters coming, defenses active.\"", "DRJCrewGunSpotFighter1760RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Fighter killed"], "idle": false, "lines": [["- \"Fighter destroyed.\"", "DRJCrewGunKillFighter1770RJCSFem_en.ogg"], ["- \"One less fighter.\"", "DRJCrewGunKillFighter1780RJCSFem_en.ogg"], ["- \"Boom.\"", "DRJCrewGunKillFighter1790RJCSFem_en.ogg"], ["- \"Logging a kill.\"", "DRJCrewGunKillFighter1800RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Boarding party"], "idle": false, "lines": [["- \"Shipboard sovereignty violated. Trespassers!\"", "DRJCrewEnemySpot1690RJCSFem_en.ogg"], ["- \"Ship has trespassers. Impolite!\"", "DRJCrewEnemySpot1700RJCSFem_en.ogg"], ["- \"Unauthorized visitors!\"", "DRJCrewEnemySpot1710RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Boarder killed"], "idle": false, "lines": [["- \"Oh. I killed someone.\"", "DRJCrewEnemyDefeat1720RJCSFem_en.ogg"], ["- \"One less boarder.\"", "DRJCrewEnemyDefeat1730RJCSFem_en.ogg"], ["- \"Intruder terminated.\"", "DRJCrewEnemyDefeat1740RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Completing a task"], "idle": false, "lines": [["- \"Logging task complete.\"", "DRJCrewTaskDone1660RJCSFem_en.ogg"], ["- \"Attention. Assignment done.\"", "DRJCrewTaskDone1670RJCSFem_en.ogg"], ["- \"Instructions carried out!\"", "DRJCrewTaskDone1680RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Railjack health low"], "idle": false, "lines": [["- \"I suggest greater caution. We do not have a spare hull!\"", "DRJCrewShipLow1810RJCSFem_en.ogg"], ["- \"Our hull is becoming excitingly sparse!\"", "DRJCrewShipLow1820RJCSFem_en.ogg"], ["- \"This vessel's hull cannot withstand much more damage of this kind!\"", "DRJCrewShipLow1830RJCSFem_en.ogg"], ["- \"If the hull damage gets any worse, we shall have an amazing view of the cosmos!\"", "DRJCrewShipLow1840RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Hazard on board"], "idle": false, "lines": [["**Fire**", null], ["- \"This vessel is on fire!\"", "DRJCrewSeeFire1850RJCSFem_en.ogg"], ["- \"There probably should not be a fire here.\"", "DRJCrewSeeFire1860RJCSFem_en.ogg"], ["**Hull breach**", null], ["- \"Breach. Losing atmosphere!\"", "DRJCrewSeeBreach1870RJCSFem_en.ogg"], ["- \"It is freezing, and windy, and— there is a hull breach!\"", "DRJCrewSeeBreach1880RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Repairing hazard"], "idle": false, "lines": [["**Fire**", null], ["- \"Fire is out!\"", "DRJCrewFixFire1890RJCSFem_en.ogg"], ["- \"Fire is gone! Fumes... are not. Whooo.\"", "DRJCrewFixFire1900RJCSFem_en.ogg"], ["**Hull breach**", null], ["- \"This breach... is closed!\"", "DRJCrewFixBreach1910RJCSFem_en.ogg"], ["- \"Breach closed.\"", "DRJCrewFixBreach1920RJCSFem_en.ogg"], ["**Out of revolite**", null], ["- \"Someone has used all the revolite!\"", "DRJCrewNeedRevolite1930RJCSFem_en.ogg"], ["- \"Revolite is all out!\"", "DRJCrewNeedRevolite1940RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Health low"], "idle": false, "lines": [["- \"Not doing well here!\"", "DRJCrewNearDeath1950RJCSFem_en.ogg"], ["- \"I am in need of backup!\"", "DRJCrewNearDeath1960RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Downed"], "idle": false, "lines": [["- \"I am in need of medical assistance.\"", "DRJCrewNeedRevive1970RJCSFem_en.ogg"], ["- \"I have suffered a serious injury. Please help.\"", "DRJCrewNeedRevive1980RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Revived"], "idle": false, "lines": [["- \"That is another one I owe you. Log it.\"", "DRJCrewHeal1990RJCSFem_en.ogg"], ["- \"Just in time. Thanks.\"", "DRJCrewHeal2000RJCSFem_en.ogg"], ["**Self-revive**", null], ["- \"Plasma, cartilage proliferaters, silicone double dose! (sigh) Sealing wounds.\"", "DRJCrewHealSelf2010RJCSFem_en.ogg"], ["- \"Just a moment, I will self repair.\"", "DRJCrewHealSelf2020RJCSFem_en.ogg"]]},
  {"path": ["On Railjack", "Ally dead"], "idle": false, "lines": [["- \"Our crewmate's lifesigns have ceased but their data shall live on.\"", "DRJCrewDied2030RJCSFem_en.ogg"], ["- \"Crewmate down. Genetic signature logged for posterity.\"", "DRJCrewDied2040RJCSFem_en.ogg"]]},
  {"path": ["On Equipping"], "idle": false, "lines": [["- \"Ready to come aboard, Captain.\"", "DRJCrewHired2050RJCSFem_en.ogg"], ["- \"You are the captain, fascinating.\"", "DRJCrewHired2060RJCSFem_en.ogg"], ["- \"Captain. I am fully trained in both manual and administrative labor. You have made a wise choice.\"", "DRJCrewHired2070RJCSFem_en.ogg"]]}
 ]
}
