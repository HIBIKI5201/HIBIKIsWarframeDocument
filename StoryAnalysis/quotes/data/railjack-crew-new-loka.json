 "sections": [
  {"path": [], "idle": false, "lines": [["New Loka NPC crew dialogue voiced by Amanda Hufford.", null]]},
  {"path": ["On Railjack", "Greetings"], "idle": false, "lines": [["- \"Bless the day that's given!\"", "DRJCrewGreet3620RJNLFem_en.ogg"], ["- \"Hello.\"", "DRJCrewGreet3630RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Idle"], "idle": true, "lines": [["- \"Mother bless our Captain, and keep safe from all corruption beyond the firmament. Mother bless our crew, Mother keep our provisions free from worm and mold. Mother bless Cephalon Cy.\"", "DRJCrewIdle3640RJNLFem_en.ogg"], ["- \"I'm getting used to it here. I can't smell recycled air any more, and the lights hardly ever give me a headache.\"", "DRJCrewIdle3650RJNLFem_en.ogg"], ["- \"This all seems like a fever dream. Maybe it is. Perhaps I'm still at home, in my bed, safe on Earth. How do you live like this?\"", "DRJCrewIdle3660RJNLFem_en.ogg"], ["- \"I was going to bring my little purebred Kavat on board. Ship's cat. Good luck. But then I thought, what if there's a breach and he gets sucked out? I'm sure Ticker will take fine care of him until I get back.\"", "DRJCrewIdle3670RJNLFem_en.ogg"], ["- \"There are more cells in my body than there are galaxies in the universe. Eight hundred billion more. Figures like that help keep one's ego in check.\"", "DRJCrewIdle3680RJNLFem_en.ogg"], ["- \"Take the time to stop - and listen - to your heart beat. And thank the Universe for making you. I assume there's a heart somewhere inside all of... that?\"", "DRJCrewIdle3690RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to a valid role"], "idle": false, "lines": [["- \"Of course.\"", "DRJCrewAccept3700RJNLFem_en.ogg"], ["- \"Right away.\"", "DRJCrewAccept3710RJNLFem_en.ogg"], ["- \"Got it.\"", "DRJCrewAccept3720RJNLFem_en.ogg"], ["- \"Yes.\"", "DRJCrewAccept3730RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Assigning to an invalid role"], "idle": false, "lines": [["- \"I wish I could.\"", "DRJCrewReject3780RJNLFem_en.ogg"], ["- \"I can't.\"", "DRJCrewReject3790RJNLFem_en.ogg"], ["- \"I cannot do that.\"", "DRJCrewReject3800RJNLFem_en.ogg"], ["- \"I... can't.\"", "DRJCrewReject3810RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Follow command"], "idle": false, "lines": [["- \"Coming.\"", "DRJCrewFollow3740RJNLFem_en.ogg"], ["- \"I am with you.\"", "DRJCrewFollow3750RJNLFem_en.ogg"], ["- \"As you wish.\"", "DRJCrewFollow3760RJNLFem_en.ogg"], ["- \"So be it.\"", "DRJCrewFollow3770RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Fighters approaching"], "idle": false, "lines": [["- \"The enemy draws near!\"", "DRJCrewGunSpotFighter3910RJNLFem_en.ogg"], ["- \"Fighters!\"", "DRJCrewGunSpotFighter3920RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Fighter killed"], "idle": false, "lines": [["- \"I have destroyed an enemy fighter!\"", "DRJCrewGunKillFighter3930RJNLFem_en.ogg"], ["- \"Fighter shot down!\"", "DRJCrewGunKillFighter3940RJNLFem_en.ogg"], ["- \"The sky is one enemy clearer!\"", "DRJCrewGunKillFighter3950RJNLFem_en.ogg"], ["- \"Die in flames, invader.\"", "DRJCrewGunKillFighter3960RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Boarder killed"], "idle": false, "lines": [["- \"We are pushing them back!\"", "DRJCrewEnemyDefeat3880RJNLFem_en.ogg"], ["- \"You fight well, friends! Do not relent!\"", "DRJCrewEnemyDefeat3890RJNLFem_en.ogg"], ["- \"Their will is breaking! They can be killed!\"", "DRJCrewEnemyDefeat3900RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Boarding party"], "idle": false, "lines": [["- \"The enemy has breached our sanctum.\"", "DRJCrewEnemySpot3850RJNLFem_en.ogg"], ["- \"Invaders! You shall be rebuffed!\"", "DRJCrewEnemySpot3860RJNLFem_en.ogg"], ["- \"Friends! Stand your ground, and fight!\"", "DRJCrewEnemySpot3870RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Completing a task"], "idle": false, "lines": [["- \"All done.\"", "DRJCrewTaskDone3820RJNLFem_en.ogg"], ["- \"I'm done. Anything else?\"", "DRJCrewTaskDone3830RJNLFem_en.ogg"], ["- \"My task is complete.\"", "DRJCrewTaskDone3840RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Railjack health low"], "idle": false, "lines": [["- \"This aged vessel cannot take this kind of treatment.\"", "DRJCrewShipLow3970RJNLFem_en.ogg"], ["- \"We have lost armor plating!\"", "DRJCrewShipLow3980RJNLFem_en.ogg"], ["- \"We must keep the hull intact!\"", "DRJCrewShipLow3990RJNLFem_en.ogg"], ["- \"If ships felt pain, this one would scream.\"", "DRJCrewShipLow4000RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Hazard on board"], "idle": false, "lines": [["**Fire**", null], ["- \"Fire!\"", "DRJCrewSeeFire4010RJNLFem_en.ogg"], ["- \"Friends, we burn!\"", "DRJCrewSeeFire4020RJNLFem_en.ogg"], ["**Hull breach**", null], ["- \"Our hull has been penetrated! We are losing vital oxygen!\"", "DRJCrewSeeBreach4030RJNLFem_en.ogg"], ["- \"Hull breach! Bigger than my head!\"", "DRJCrewSeeBreach4040RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Repairing hazard"], "idle": false, "lines": [["**Fire**", null], ["- \"Fire extinguished.\"", "DRJCrewFixFire4050RJNLFem_en.ogg"], ["- \"Fire quenched.\"", "DRJCrewFixFire4060RJNLFem_en.ogg"], ["**Hull breach**", null], ["- \"Sealed the breach! Repressurizing. I need to check my plants.\"", "DRJCrewFixBreach4070RJNLFem_en.ogg"], ["- \"Patched the hull.\"", "DRJCrewFixBreach4080RJNLFem_en.ogg"], ["**Out of revolite**", null], ["- \"We are out of repair material!\"", "DRJCrewNeedRevolite4090RJNLFem_en.ogg"], ["- \"No revolite left, I checked.\"", "DRJCrewNeedRevolite4100RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Health low"], "idle": false, "lines": [["- \"Friends! The enemy threatens to overwhelm!\"", "DRJCrewNearDeath4110RJNLFem_en.ogg"], ["- \"Friends! To me! And may Mother safeguard us all.\"", "DRJCrewNearDeath4120RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Downed"], "idle": false, "lines": [["- \"Aid me, ere I breath my last!\"", "DRJCrewNeedRevive4130RJNLFem_en.ogg"], ["- \"I will not die here. I will not! Aid me!”", "DRJCrewNeedRevive4140RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Revived"], "idle": false, "lines": [["- \"Thank you. I'm sure you have no need of a ghost aboard your ship.\"", "DRJCrewHeal4150RJNLFem_en.ogg"], ["- \"I thank you.\"", "DRJCrewHeal4160RJNLFem_en.ogg"], ["**Self-revive**", null], ["- \"Fine, I'll use these blasphemous medicines now and repent later.\"", "DRJCrewHealSelf4170RJNLFem_en.ogg"], ["- \"How do you even use this? (Sigh) Oh, that's better.\"", "DRJCrewHealSelf4180RJNLFem_en.ogg"]]},
  {"path": ["On Railjack", "Ally dead"], "idle": false, "lines": [["- \"Mother, I consign my friend's soul to your loving arms! Give them peace.\"", "DRJCrewDied4190RJNLFem_en.ogg"], ["- \"Our friend has departed our company. Travel well. We will meet again.\"", "DRJCrewDied4200RJNLFem_en.ogg"]]},
  {"path": ["On Equipping"], "idle": false, "lines": [["- \"Hello, Captain.\"", "DRJCrewHired4210RJNLFem_en.ogg"], ["- \"Captain. What is your policy on plants? I have... several.\"", "DRJCrewHired4220RJNLFem_en.ogg"], ["- \"Do you expect we will visit Earth? The green reclamations are so beautiful. Even the burial grounds.\"", "DRJCrewHired4230RJNLFem_en.ogg"]]}
 ]
}
