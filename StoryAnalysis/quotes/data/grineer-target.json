  {"path": ["Male Target", "While Downed"], "idle": false, "lines": [["- \"Gruneer rus trog gar!\" - \"Grineer will stop you!\"", "BbDownedGrineerVIPA090_en.ogg"], ["- \"Klus rus not go ungunusrer!\" - \"This will not go unpunished!\"", "BbDownedGrineerVIPA100_en.ogg"]]},
  {"path": ["Female Target", "When Being Chased"], "idle": false, "lines": [["- \"Klee've kome for me!\" - \"They've come for me!\"", "BbPlayerSpottedGrineerVIPB010_en.ogg"], ["- \"Shut! Tenno!\" - \"Shit! Tenno!\"", "BbPlayerSpottedGrineerVIPB020_en.ogg"], ["- \"Gar rus not kagtugre me!\" - \"You will not capture me!\"", "BbFleeingGrineerVIPB030_en.ogg"], ["- \"Khus klem!\" - \"Kill them!\"", "BbFleeingGrineerVIPB040_en.ogg"], ["- \"Fught to gre reakl!\" - \"Fight to the death!\"", "BbFoundGrineerVIPB060_en.ogg"], ["- \"Reakl befogre kagtugre!\" - \"Death before capture!\"", "BbFoundGrineerVIPB070_en.ogg"]]},
