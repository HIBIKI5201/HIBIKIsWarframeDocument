  {"path": [], "idle": false, "lines": [["Quotes spoken by Adis Truth-Bloom.", null]]},
  {"path": ["In The Old Peace", "Hide and Seek"], "idle": false, "lines": [["**Reach Rovis Crater**", null], ["- \"Mo hu-da, Ten-no. I win. You let?\"", "DCinThreeSunrise0040Adis_en.ogg"], ["- \"Call it - peace offer!\"", "DCinThreeSunrise0060Adis_en.ogg"], ["- \"How late the we?\"", "DCineFiveWereLate0190Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Down the Rabbit Hole"], "idle": false, "lines": [["**Report for Duty**", null], ["- \"Not joke, Tenno.\"", "DExamHybridWF0220Adis_en.ogg"], ["**View Tau System with Adis**", null], ["- \"What your parents say, if they here?\"", "DExamHybridWF0222Adis_en.ogg"], ["Your parents?", null], ["- \"Making up the great Rail, was the telling. First you serve as labor. Then you serve as parts.\"", "DExamHybridWF0225Adis_en.ogg"], ["Rematch?", null], ["- \"First we find new fighting place! We get caught, Grineer think war-times come again!\"", "DExamHybridWF0227Adis_en.ogg"], ["Ready for your test?", null], ["- \"Adis... maybe forgot Naramon principles section 8?\"", "DExamHybridWF0229Adis_en.ogg"], ["**Check on the New Hybrid Project**", null], ["- \"Stupid.\"", "DReturnCaliban0260Adis_en.ogg"], ["**Follow Archimedean Itzam**", null], ["A new Somatic connection.", null], ["- \"Uh, a Somatic connection new, power increase many?\"", "DTauron0340Adis_en.ogg"], ["A regression in stability.", null], ["- \"Stability regress? Great badness?\"", "DTauron0342Adis_en.ogg"], ["It's a trick question.", null], ["- \"Cannot be done! You are tricking.\"", "DTauron0346Adis_en.ogg"], ["**Get to the Airlock**", null], ["- \"Adis did not choose name!\"", "DTauron0362Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Back to the Front"], "idle": false, "lines": [["**Assist Casualties**", null], ["- \"Cast and cry, cast and cry\" ｜ \"Raise the million pylons high\" ｜ \"All our kin are bound to fly\" ｜ \"For that far shore forlorn\"", "DSubdueCaliban0250Adis_en.ogg"], ["- \"Ten-no!\"", "DLocateCannon0490Adis_en.ogg"], ["- \"Trust the we.\"", "DReachValdur0450Adis_en.ogg"], ["**Locate Makvos Cannon**", null], ["- \"You are authentic friend, Tenno.\"", "DLocateCannon0470Adis_en.ogg"], ["- \"Tau fills me.\"", "DLocateCannon0500Adis_en.ogg"], ["- \"I got it!\"", "DDestroyCannon0535Adis_en.ogg"], ["**Follow Adis**", null], ["- \"Yarata! Now, Tenno!\"", "DDestroyCannon0538Adis_en.ogg"], ["- \"Hurry, Tenno!\"", "DFreeHostage0565Adis_en.ogg"], ["**Rescue the Captured Sentient**", null], ["- \"Bad place. Golden-cursed. Long-ago precepting.\"", "DFreeHostage0570Adis_en.ogg"], ["- \"But... the blooms make us more than machine! Why does she hate?\"", "DFreeHostage0635Adis_en.ogg"], ["- \"Coming, hive-kin!\"", "DFreeHostage0580Adis_en.ogg"], ["- \"Let him go!\"", "DFreeHostage0650Adis_en.ogg"], ["**Subdue the Hostile Dactolyst**", null], ["- \"Hive-kin, Adis will heal!\" (singing) \"Cast and cry, cast and cry\" ｜ \"Raise the million pylons high\" ｜ \"All our kin are bound to fly\" ｜ \"For that far shore forlorn\"", "DFreeHostage0675Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Too Far!"], "idle": false, "lines": [["**Find Adis**", null], ["- \"Many things.\"", "DTauQuest0910Adis_en.ogg"], ["- \"I know.\"", "DTauQuest0930Adis_en.ogg"], ["- \"Let's not lose the We also.\"", "DTauQuest0940Adis_en.ogg"], ["- \"Always.\"", "DTauQuest0960Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Interrogation"], "idle": false, "lines": [["- \"Tenno, go after ones with big shiny hat!\"", "DTauQuest1000Adis_en.ogg"], ["- \"Lus-tra-tus? They lead. They know orders from Galastra. Make them tell!\"", "DTauQuest1020Adis_en.ogg"], ["**Interrogating 1st Lustratus**", null], ["- \"Dax cannot defy Kuva. But Anarchs defy Orokin? How?\"", "DTauQuest1090Adis_en.ogg"], ["- \"Maybe through hive-kin... they try to find a way?\"", "DTauQuest1110Adis_en.ogg"], ["- \"Adis not talk.\"", "DTauQuest1140Adis_en.ogg"], ["**Interrogating 2nd Lustratus**", null], ["- \"With the blooms, Tau made us free. All know this.\"", "DTauQuest1170Adis_en.ogg"], ["- \"Hunger. For orders. If none come... hivemind would return.\"", "DTauQuest1190Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Fallen From Heaven"], "idle": false, "lines": [["- \"Void cloak emittings. Hidden Dax close. Careful, Tenno!\"", "DTauQuest1270Adis_en.ogg"], ["**Defeat Ambush**", null], ["- \"On board is who?\"", "DTauQuest1310Adis_en.ogg"], ["**Escort the Executor to Safety**", null], ["- \"Tenno. Decrypted transmission. Listen!\"", "DTauQuest1360Adis_en.ogg"], ["- \"A devil-frame who did devil's work! He deserve this, Ten-no.\"", "DTauQuest1410Adis_en.ogg"], ["- \"Tenno! More transmission!\"", "DTauQuest1420Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Eden's Ultimatum"], "idle": false, "lines": [["**Follow Adis**", null], ["- \"Amar! Amar!\"", "DTauQuest1640Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Assault on Zariman Five-Nine"], "idle": false, "lines": [["- \"Control frames, but no Tenno? Galastra burn herself up for sure.\"", "DTauQuest1985Adis_en.ogg"], ["- \"What is happen?\"", "DTauQuest2020Adis_en.ogg"], ["- \"It's okay. I'm here. My light goes with you. Always.\"", "DTauQuest2070Adis_en.ogg"], ["**Trigger Destruct Sequence**", null], ["- \"Why would Adis ever want to be like you?\"", "DTauQuest2250Adis_en.ogg"], ["- \"Tenno...\"", "DTauQuest2270Adis_en.ogg"], ["- \"How many Golden curse-pods, Tenno? Enough for whole world? For whole SYSTEM?\"", "DTauQuest2280Adis_en.ogg"], ["- \"Voko ra'haal. Margulis dies for this.\"", "DTauQuest2300Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Battle of the Last Bloom"], "idle": false, "lines": [["**Reach Rovis Crater**", null], ["- \"Always you know where to find me, Ten-no.\"", "DTauQuest2305Adis_en.ogg"], ["- \"Bar hakh, Tenno! Shut... up!\"", "DTauQuest2340Adis_en.ogg"], ["- \"M'aran tegu LOKSH! You are blind as she!\"", "DTauQuest2370Adis_en.ogg"], ["- \"Tenno... LIES!\"", "DTauQuest2390Adis_en.ogg"], ["- \"Tenno... you were right. I... am sorry-\"", "DTauQuest2400Adis_en.ogg"], ["- \"Tenno. I heal. I try!\"", "DTauQuest2420Adis_en.ogg"], ["- \"(singing) \"Cast and cry, cast and cry\" ｜ \"Raise the million pylons high\" ｜ \"All our kin are bound to fly\" ｜ \"For that far shore forlorn\"", "DSubdueCaliban0250Adis_en.ogg"], ["**Destroy Orokin Cleanup Squad**", null], ["- \"Let me feel... sunlight?\"", "DTauQuest2450Adis_en.ogg"], ["- \"My light goes with you now.\"", "DTauQuest2460Adis_en.ogg"]]},
  {"path": ["In The Old Peace", "Unused/Unsorted"], "idle": false, "lines": [["- \"It's ok, it's ok.\" (Text-to-Speech)", "DReturnCaliban0275Adis_en.ogg"], ["- \"Whole now. Good-good.\"", "DReachValdur0420Adis_en.ogg"], ["- \"Harmony, not! Friend? ...yes.\"", "DTauQuest1680Adis_en.ogg"], ["- \"Perfect is noisy also.\"", "DTauQuest1700Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Capture Supply Caches"], "idle": false, "lines": [["**Reminder**", null], ["- \"Capture cache, need stay close.\"", "DCasesClose1220Adis_en.ogg"], ["- \"Close get, to capture cache.\"", "DCasesClose1230Adis_en.ogg"], ["- \"Anarchs close, make gone, get cache.\"", "DCasesClose1240Adis_en.ogg"], ["**Cache captured by player**", null], ["- \"Valdur, the Ten-no captures a cache.\"", "DCasesCap1250Adis_en.ogg"], ["- \"Cache captured. Strong Ten-no friend.\"", "DCasesCap1260Adis_en.ogg"], ["- \"Supplies captured. Battle-kin to be much relieved.\"", "DCasesCap1270Adis_en.ogg"], ["**Cache captured by Anarchs**", null], ["- \"Anarchs take the death-foods. Not good.\"", "DCasesEnemyCap1280Adis_en.ogg"], ["- \"Ten-no! Cache for we, not for them!\"", "DCasesEnemyCap1290Adis_en.ogg"], ["- \"Too late, Ten-no. Enemy get that one.\"", "DCasesEnemyCap1300Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Destroy Anarch Targeting Array"], "idle": false, "lines": [["**Codes needed**", null], ["- \"Progress stops. New access codes needed. You find?\"", "DSabCred2070Adis_en.ogg"], ["- \"Node control interrupted. Must find new Anarch codes.\"", "DSabCred2080Adis_en.ogg"], ["- \"Stalled. New code needed. Find please.\"", "DSabCred2090Adis_en.ogg"], ["**Node hacked**", null], ["- \"Node scrambled. Guns quiet. Make scrap now? Find new codes.\"", "DSabDest2100Adis_en.ogg"], ["- \"Corruption complete. Anarch targeting impossible now. Use authorization? Make permanent?\"", "DSabDest2110Adis_en.ogg"], ["- \"Node is useless, for now. Time to initiate meltdown protocol?\"", "DSabDest2120Adis_en.ogg"], ["**Node destroyed**", null], ["- \"Node collapsed.\"", "DSabFirstDest2130Adis_en.ogg"], ["- \"Rapid disassembly successful. Again!\"", "DSabFirstDest2140Adis_en.ogg"], ["- \"Node smashed.\"", "DSabFirstDest2150Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Destroy Hidden Ground Scanners"], "idle": false, "lines": [["**Scanner blocked**", null], ["- \"Detector scrambled. Anarchs too many.\"", "DHiddenSabBlocked1580Adis_en.ogg"], ["- \"Lose signal. Much interference, much Anarchs.\"", "DHiddenSabBlocked1590Adis_en.ogg"], ["- \"Detector troubles. Offending Anarchs, remove.\"", "DHiddenSabBlocked1600Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Destroy the Anarch Supply Transport"], "idle": false, "lines": [["**Repair pads reminder**", null], ["- \"Ten-no! Repair pads! Destroy! Or transport never explode.\"", "DDestConvoyRepair0500Adis_en.ogg"], ["- \"Repair pads. All over place. Must stop or else.\"", "DDestConvoyRepair0510Adis_en.ogg"], ["- \"Target repair pads, Ten-no.\"", "DDestConvoyRepair0520Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Destroy the Makvos Cannon"], "idle": false, "lines": [["**Attacking Cannon before hack complete**", null], ["- \"Armor too strong. Find codes, talk to vents, expose munitions, boom.\"", "DCanSabWeakpoints1070Adis_en.ogg"], ["- \"Find codemaster. Expose munitions. Explode munitions?\"", "DCanSabWeakpoints1080Adis_en.ogg"], ["- \"Expose munitions with codes? Which Anarch is codemaster?\"", "DCanSabWeakpoints1090Adis_en.ogg"], ["**Hack complete**", null], ["- \"Munitions exposed. Detonate now?\"", "DCanSabHackSuccess1100Adis_en.ogg"], ["- \"Ten-no opened munitions vent.\"", "DCanSabHackSuccess1110Adis_en.ogg"], ["- \"Munitions vent exposed. Bad for Anarch, good for we.\"", "DCanSabHackSuccess1120Adis_en.ogg"], ["**While cannon exposed**", null], ["- \"Shoot cannon? Make big boom?\"", "DCanSabDest1130Adis_en.ogg"], ["- \"Cannon weak. Opportunity now.\"", "DCanSabDest1140Adis_en.ogg"], ["- \"Makvos cannon on brink. Job finish.\"", "DCanSabDest1150Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Draw out the Commandeered Prime Warframe"], "idle": false, "lines": [["**Dropship arriving**", null], ["- \"Alertness, Ten-no! Anarchs foot bound.\"", "DDropEnemyDeploy1370Adis_en.ogg"], ["- \"Attackers released, trouble now.\"", "DDropEnemyDeploy1380Adis_en.ogg"], ["- \"Ten-no, Anarchs fall from air like bloom-seeds!\"", "DDropEnemyDeploy1390Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Eliminate Anarchs"], "idle": false, "lines": [["**Beacon used**", null], ["- \"Be alert, Ten-no, more come.\"", "DExtermBeaconAct0710Adis_en.ogg"], ["- \"Watch! In blink Anarchs.\"", "DExtermBeaconAct0720Adis_en.ogg"], ["- \"Blink pads charge. More Anarchs come.\"", "DExtermBeaconAct0730Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Free Allied Brachiolysts"], "idle": false, "lines": [["**Intro**", null], ["- \"Ten-no! Hive-kin stolen. Save before hive-kin cores changed to Anarch mind.\"", "DSquadIntro0850Adis_en.ogg"], ["- \"Hive-kin in trouble. Must stop captor. Return kin to hive.\"", "DSquadIntro0860Adis_en.ogg"], ["**Brachiolyst freed**", null], ["- \"Hive-kin, you are free. Follow Ten-no.\"", "DSquadFreedBrach0870Adis_en.ogg"], ["- \"Hive-kin. Fast move. Go.\"", "DSquadFreedBrach0880Adis_en.ogg"], ["**Order completed**", null], ["- \"Hive-kin lives to fight!\"", "DSquadComp0940Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Free Conculyst Scout"], "idle": false, "lines": [["**Intro**", null], ["- \"Ten-no, help needed. Hive-kin taken. Bring home.\"", "DStealthRescueIntro1790Adis_en.ogg"], ["- \"Anarchs stole hive-kin. Put in cage. Tenno do right thing.\"", "DStealthRescueIntro1800Adis_en.ogg"], ["**Scout freed**", null], ["- \"Hive-kin! Follow Ten-no.\"", "DStealthRescueSentFreed1830Adis_en.ogg"], ["- \"Hive-kin go clear! Ten-no is friend.\"", "DStealthRescueSentFreed1840Adis_en.ogg"], ["- \"Ten-no make hive-kin safe for certain.\"", "DStealthRescueSentFreed1850Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Install Shuttle Uplink"], "idle": false, "lines": [["**Shuttle hacked**", null], ["- \"Systems online. Engines start slow. Keep safe.\"", "DShuttleHacked2220Adis_en.ogg"], ["- \"Control got! Ten-no protect?\"", "DShuttleHacked2230Adis_en.ogg"], ["- \"Adis is pilot now. Engines warming.\"", "DShuttleHacked2240Adis_en.ogg"], ["**Shuttle under fire**", null], ["- \"Anarchs airborne. Please protect.\"", "DShuttleEnemy2250Adis_en.ogg"], ["- \"Damage mounting. Stop Anarchs.\"", "DShuttleEnemy2260Adis_en.ogg"], ["- \"Ten-no, ship taking damage!\"", "DShuttleEnemy2270Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Power the Transmitter"], "idle": false, "lines": [["**Battery crafted**", null], ["- \"Battery assembled. Transmitter hungry for power.\"", "DShieldsBattCraft1700Adis_en.ogg"], ["- \"Ten-no made battery. Power transmitter now?\"", "DShieldsBattCraft1710Adis_en.ogg"], ["- \"Battery crude, but work still. Put in transmitter.\"", "DShieldsBattCraft1720Adis_en.ogg"], ["**Battery reminder**", null], ["- \"Anarch gear! Could battery make?\"", "DShieldsBattRem1670Adis_en.ogg"], ["- \"Anarch weapons outfit include cathode and anode. Battery make?\"", "DShieldsBattRem1680Adis_en.ogg"], ["- \"Adis detect cathode and anode parts on Anarchs. Ten-no use!\"", "DShieldsBattRem1690Adis_en.ogg"], ["**50% power**", null], ["- \"Fifty-percent power, do not stop now.\"", "DShieldsPowerFifty1740Adis_en.ogg"], ["- \"We are so close, get more power.\"", "DShieldsPowerFifty1750Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Supply Turrets with Turret Ammunition"], "idle": false, "lines": [["**Reminder**", null], ["- \"Turret hungry. Need reload.\"", "DSupplyDropFeed1950Adis_en.ogg"], ["- \"Turret need ammo immediately.\"", "DSupplyDropFeed1960Adis_en.ogg"], ["- \"Will Ten-no give turret ammunition?\"", "DSupplyDropFeed1970Adis_en.ogg"], ["**Dropzone occupied**", null], ["- \"Anarchs block drop. Must remove.\"", "DSupplyDropOccupied1920Adis_en.ogg"], ["- \"No drop until Anarch out.\"", "DSupplyDropOccupied1930Adis_en.ogg"], ["- \"Drop zone too hot. Clear you must.\"", "DSupplyDropOccupied1940Adis_en.ogg"], ["**Final drop**", null], ["- \"One more comes.\"", "DSupplyDropLast1980Adis_en.ogg"], ["- \"Last drop.\"", "DSupplyDropLast1990Adis_en.ogg"], ["- \"Just one more.\"", "DSupplyDropLast2000Adis_en.ogg"]]},
  {"path": ["In The Perita Rebellion", "Recharge"], "idle": false, "lines": [["**Intro**", null], ["- \"Hive-kin in trouble. Needs help. Needs Energy Core. You help, Adis knows.\"", "DSentDefIntro0560Adis_en.ogg"], ["- \"Ten-no must help hive-kin. Anarchs attack, energy low. You must save.\"", "DSentDefIntro0570Adis_en.ogg"], ["- \"Valdur! Adis need Ten-no! Hive-kin under attack. Anarchs drain energy. Death near. Help kin now!\"", "DSentDefIntro0580Adis_en.ogg"], ["**Core found**", null], ["- \"Take seed-core to kin.\"", "DSentDefCoreFound0590Adis_en.ogg"], ["- \"Energy is aid. Bring to hive-kin.\"", "DSentDefCoreFound0600Adis_en.ogg"], ["- \"Hurry, Tenno! Hive-kin needs energy-core for live.\"", "DSentDefCoreFound0610Adis_en.ogg"], ["**Core absorbed**", null], ["- \"Kin breathes hive-life. Lives to fight.\"", "DSentDefCoreAbsorbed0620Adis_en.ogg"], ["- \"Energy is life.\"", "DSentDefCoreAbsorbed0630Adis_en.ogg"], ["- \"Stay close to hive-kin, Tenno.\"", "DSentDefCoreAbsorbed0640Adis_en.ogg"], ["**Order completed**", null], ["- \"Hive-kin safe. Hive-kin thank Ten-no. Tenno back to orders now.\"", "DSentDefComp0650Adis_en.ogg"], ["- \"Tenno friend saves hive-kin friend. Valdur has new orders.\"", "DSentDefComp0660Adis_en.ogg"], ["- \"Friend needed for fight. Ten-no help all hive-kin.\"", "DSentDefComp0670Adis_en.ogg"]]}
 ]
