  {"path": ["Current", "Taunts"], "idle": false, "lines": [["One taunt is randomly selected from each group, in order, for each of the three taunts played before Stalker's arrival in a mission. Words surrounded by brackets indicate text shown in the transmission box, but not voiced in-game.", null]]},
  {"path": ["Current", "Taunts", "Taunt 1"], "idle": false, "lines": [["- \"[(Player's name)], you can't run from your past.\"", "DStkrTaunt00150_en.ogg"], ["- \"I know your every move, [(Player's name)].\"", "DStkrTaunt00160_en.ogg"], ["- \"[(Player's name)], there is no place to hide.\"", "DStkrTaunt00170_en.ogg"]]},
  {"path": ["Current", "Taunts", "Taunt 2"], "idle": false, "lines": [["- \"The murder [of (boss' name)] will not go unpunished.\"", "DStkrTaunt00180_en.ogg"], ["- \"There is no salvation for your crime [against (boss' name)].\"", "DStkrTaunt00200_en.ogg"], ["- \"The blood [of (boss' name)] is on your hands. [Did you really think there would be no repercussions?]\"", "DStkrTaunt00190_en.ogg"]]},
  {"path": ["Current", "Taunts", "Taunt 3"], "idle": false, "lines": [["- \"I am your reckoning!\"", "DStkrTaunt00230_en.ogg"], ["- \"Your sentence is death!\"", "DStkrTaunt00210_en.ogg"], ["- \"You shall not leave this place!\"", "DStkrTaunt00220_en.ogg"]]},
  {"path": ["Current", "Warframe Ability Used"], "idle": false, "lines": [["- \"Your TENNO powers are useless!\"", "DStkrTaunt00140_en.ogg"]]},
  {"path": ["Current", "Target Player Defeated"], "idle": false, "lines": [["- \"It is done. You are no more. [(Player's name) is no more.]\"", "DStkrTaunt00310_en.ogg"], ["- \"[(Player's name)] You shall not trouble us again.\"", "DStkrTaunt00330_en.ogg"], ["- \"Justice is served. [(Player's name)] has been executed.]\"", "DStkrTaunt00320_en.ogg"]]},
  {"path": ["Current", "Upon Defeat"], "idle": false, "lines": [["- \"What have you...done?\"", "DStkrTaunt00300_en.ogg"], ["- \"No?! This is not... possible.\"", "DStkrTaunt00290_en.ogg"], ["- \"I have failed. [(Player's name)] lives.\"", null], ["- \"I... have failed... this one will remain... unpunished...\"", "DStkrTaunt00280_en.ogg"]]},
  {"path": ["Current", "Special Interactions"], "idle": false, "lines": [["**Jade present in squad**", null], ["- \"Never.\"", "DHubOne0070Stkr_en.ogg"], ["**Sirius & Orion present in squad**", null], ["- \"Show me you've learned.\"", "DSiriusOrionInvasion1190Stkr_en.ogg"]]},
  {"path": ["Current", "During The Second Dream", "Meeting with Hunhow"], "idle": false, "lines": [["- \"Tenno.\"", "DCinUnderseaLair00020Stkr_en.ogg"], ["- \"Lotus.\"", "DCinUnderseaLair00040Stkr_en.ogg"], ["- \"Who?\"", "DCinUnderseaLair00060Stkr_en.ogg"]]},
