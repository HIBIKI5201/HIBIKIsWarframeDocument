  {"path": ["Current", "During Jade Shadows", "Past and Future"], "idle": false, "lines": [["- \"But... the Legems! If the Lords found out-\"", "DMissionSix0590Stkr_en.ogg"], ["Name your child Sirius?", null], ["- \"Sirius...\"", "DMissionSix0604Stkr_en.ogg"], ["Name your child Orion?", null], ["- \"Orion...\"", "DMissionSix0605Stkr_en.ogg"]]},
