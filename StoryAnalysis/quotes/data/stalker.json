  {"path": ["Current", "In Pontis Tower"], "idle": false, "lines": [["- \"Here, we shall not fight.\"", "DStlkrProxBarks1060Stkr_en.ogg"], ["- \"It... is well.\"", "DStlkrProxBarks1070Stkr_en.ogg"], ["- \"Remember her.\"", "DStlkrProxBarks1080Stkr_en.ogg"], ["- \"Two. And one.\"", "DStlkrProxBarks1090Stkr_en.ogg"], ["- \"Jade...\"", "DStlkrProxBarks1100Stkr_en.ogg"], ["- \"You may go.\"", "DStlkrProxBarks1120Stkr_en.ogg"], ["- \"Protect... him.\"", "DStlkrProxBarks1130Stkr_en.ogg"], ["- \"Tread lightly.\"", "DStlkrProxBarks1140Stkr_en.ogg"], ["- \"We are not friends.\"", "DStlkrProxBarks1150Stkr_en.ogg"], ["- \"Watch them.\"", "DStlkrProxBarks1160Stkr_en.ogg"], ["- \"Keep this peace.\"", "DStlkrProxBarks1170Stkr_en.ogg"], ["- \"I am watching.\"", "DStlkrProxBarks1180Stkr_en.ogg"]]},
