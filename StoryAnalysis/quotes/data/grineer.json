  {"path": ["During the Tutorial"], "idle": false, "lines": [["- \"Guv elik'draedre kuhl de'mon! Klos aer tu th'rock!\" - \"You shouldn't be here old man! This is my prize!\"", "GrineerTutorial1.ogg"], ["- Note: The words used in the above statements seem to differ from the usual manner of speaking for the Grineer (i.e. \"Guv\" instead of \"Gar\" for the word \"you\"). Possible explanation:", null], ["- It may be because the speaker is using a different context/connotation (formal/informal fashion of addressing another body) to speak to Vor, seeing as how he is seen to act rash toward him which implies he is equal with him in ranking (so he can get away with it). Using the same logic, it may also be an attempt to demean him/detract from his status or importance.", null], ["- \"Agre gar dhutrenhung to me? Re's mhune!\" - \"Are you listening to me? He's mine!\"", "GrineerTutorial2.ogg"]]},
  {"path": ["Once Awake"], "idle": false, "lines": [["- \"The Tenno! Keep them away from the specimens!\"", "OAGrineer1.ogg"], ["- \"Destroy them! Dr. Tengus demands absolute secrecy!\"", "OAGrineer2.ogg"], ["- \"Who released the specimens? Stop the Infested, forget the Tenno!\"", "OAGrineer3.ogg"], ["- \"They're out! What's going on?\"", "OAGrineer4.ogg"], ["- \"Who let them out? Was it Tengus?\"", "OAGrineer5.ogg"], ["- \"Tengus did this! I know he did!\"", "OAGrineer6.ogg"]]},
  {"path": ["General"], "idle": false, "lines": [["Male Grineer have two different voices. Which voice is used is independent on the Grineer unit.", null]]},
  {"path": ["General", "Idle"], "idle": true, "lines": [["- \"Agrea grear.\" - \"Area clear.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle1.ogg"], ["- \"Ok... ok, hu'ss kreff.\" - \"Ok... ok, I'll check.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle2.ogg"], ["- \"Am hu seehung klhungs?\" - \"Am I seeing things?\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle3.ogg"], ["- \"As grear hun klos sektor.\" - \"All clear in this sector.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle4.ogg"], ["- \"Ror? Klouvor hu rearr someklhung.\" - \"Huh? Thought I heard something.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle5.ogg"], ["- \"No aktuvhutee to gregort.\" - \"No activity to report.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle6.ogg"], ["- \"Hut's too kwuhute hun regre.\" - \"It's too quiet in here.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle7.ogg"], ["- \"Rey, deave tu mokler oot of klos.\" - \"Hey, leave my mother out of this.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle8.ogg"], ["- \"Hu'm bregrer oot of tu mhunr.\" - \"I'm bored out of my mind.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle9.ogg"], ["- \"Gar guis see anykling suspukhuous?\" - \"You guys see anything suspicious?\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle10.ogg"], ["- \"Jutr onke, hu rhusr hut rudor get ekskhutung around reger.\" - \"Just once, I wish it would get exciting around here.\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle11.ogg"], ["- \"Ror rur hu get truf rhukl klus kotr? Sekurhuty agahuntr grat?\" - \"How did I get stuck with this post? Security against what?\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAIdle12.ogg"]]},
  {"path": ["General", "Seeing a Warframe", "Unalerted"], "idle": false, "lines": [["- \"Ror?\" - \"Huh?\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAUnalert1.ogg"], ["- \"Or no!\" - \"Oh no!\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAUnalert2.ogg"], ["- \"Grat kle...?\" - \"What the...?\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAUnalert3.ogg"], ["- \"Orre klegra!\" - \"Over there!\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAUnalert4.ogg"], ["- \"Ror? Grat's klat?\" - \"Huh? What's that?\"", null], ["- Male A / Male B / Female", null], ["- / /", "GrineerTroopMAUnalert5.ogg"]]},
