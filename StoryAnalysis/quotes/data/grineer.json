  {"path": ["Kuva Larvling Transmissions"], "idle": false, "lines": [["Main article: Kuva Lich/Quotes#Kuva Larvling Spawn", null], ["These voice lines are spoken by Kuva Guardians when a Kuva Larvling is about to spawn.", null], ["- \"Sukjekkt found. Moderate clone rot. Initiating reclamation.\"", "DLichTease0010GrnQueensGrds_en.ogg"], ["- \"Reclamation target sighted. Mental conditions severely deteriorated. Abort!\"", "DLichTease0020GrnQueensGrds_en.ogg"], ["- \"Queens will not be pleased. Clone rot has gone too far. Send word.\"", "DLichTease0030GrnQueensGrds_en.ogg"], ["- \"Sukjekkt found. In her name.\"", "DLichTease0040GrnQueensGrds_en.ogg"], ["- \"Soldier, you have been nominated. Your glory awaits in her fortress.\"", "DLichTease0050GrnQueensGrds_en.ogg"], ["- \"Sukjekkt found. Significant trauma. Removing to galleon to assess Kuva Lich viability.\"", "DLichTease0060GrnQueensGrds_en.ogg"], ["- \"Inform the Queens we have found their sukjekkt.\"", "DLichTease0070GrnQueensGrds_en.ogg"]]},
  {"path": ["Kuva Larvling Transmissions", "Killing the Larvling"], "idle": false, "lines": [["- \"Sukjekkt secured. Removing from battlefield. Peezporr enkkaagge kraaft!\"", "DLichTease0080GrnQueensGrds_en.ogg"], ["- \"The Queens have chosen you, soldier. You are to be gifted.\"", "DLichTease0090GrnQueensGrds_en.ogg"], ["- \"You are the Queen-chosen, soldier. Greatness awaits you. Greatness... or perhaps death.\"", "DLichTease0100GrnQueensGrds_en.ogg"], ["- \"We have the chosen sukjekkt. They will become Lich, or die.\"", "DLichTease0110GrnQueensGrds_en.ogg"]]},
  {"path": ["Male Prime Grineer", "Patrol"], "idle": false, "lines": [["- \"Maybe some land for Grineer too. Planet big enough.\"", "BbPatrolPrimeGrineerMale0860_en.ogg"], ["- \"So many brothers dead every day.\"", "BbPatrolPrimeGrineerMale0870_en.ogg"], ["- \"First week alive. Not great. Maybe second week better.\"", "BbPatrolPrimeGrineerMale0880_en.ogg"], ["- \"Tenno fast, Tenno strong, but Grineer many.\"", "BbPatrolPrimeGrineerMale0890_en.ogg"], ["- \"Once Orokin shout order, now Dax shout order. Nothing but obey order.\"", "BbPatrolPrimeGrineerMale0900_en.ogg"], ["- \"My genes are the best genes.\"", "BbPatrolPrimeGrineerMale0910_en.ogg"], ["- \"I fight! I win! My genes live on!\"", "BbPatrolPrimeGrineerMale0920_en.ogg"], ["- \"Grineer have rise so far from what we were! What we be in a thousand years!\"", "BbPatrolPrimeGrineerMale0930_en.ogg"]]},
  {"path": ["Male Prime Grineer", "Enemy Spotted"], "idle": false, "lines": [["- \"There!\"", "BbEnemySpottedPrimeGrineerMale0940_en.ogg"], ["- \"Locking on!\"", "BbEnemySpottedPrimeGrineerMale0950_en.ogg"], ["- \"Open fire! Our weapons!\"", "BbEnemySpottedPrimeGrineerMale0960_en.ogg"], ["- \"Target identified!\"", "BbEnemySpottedPrimeGrineerMale0970_en.ogg"], ["- \"Hostiles!\"", "BbEnemySpottedPrimeGrineerMale0980_en.ogg"], ["- \"Enemy is exposed!\"", "BbEnemySpottedPrimeGrineerMale0990_en.ogg"], ["- \"Take them down!\"", "BbEnemySpottedPrimeGrineerMale1000_en.ogg"], ["- \"Brothers! Over there!\"", "BbEnemySpottedPrimeGrineerMale1010_en.ogg"], ["- \"Get them!\"", "BbEnemySpottedPrimeGrineerMale1020_en.ogg"], ["- \"Scum!\"", "BbEnemySpottedPrimeGrineerMale1030_en.ogg"], ["- \"I see them!\"", "BbEnemySpottedPrimeGrineerMale1040_en.ogg"], ["- \"Get a lock!\"", "BbEnemySpottedPrimeGrineerMale1050_en.ogg"], ["- \"Blow them away!\"", "BbEnemySpottedPrimeGrineerMale1060_en.ogg"], ["- \"Over there!\"", "BbEnemySpottedPrimeGrineerMale1070_en.ogg"], ["- \"I see you!\"", "BbEnemySpottedPrimeGrineerMale1080_en.ogg"], ["- \"Marking target!\"", "BbEnemySpottedPrimeGrineerMale1090_en.ogg"]]},
  {"path": ["Male Prime Grineer", "Attack"], "idle": false, "lines": [["- \"Take them apart!\"", "BbAttackPrimeGrineerMale0010_en.ogg"], ["- \"Target spotted!\"", "BbAttackPrimeGrineerMale0020_en.ogg"], ["- \"Alpha Formation, go!\"", "BbAttackPrimeGrineerMale0030_en.ogg"], ["- \"Let's secure the perimeter!\"", "BbAttackPrimeGrineerMale0040_en.ogg"], ["- \"Go, go, go!\"", "BbAttackPrimeGrineerMale0050_en.ogg"], ["- \"Focus fire!\"", "BbAttackPrimeGrineerMale0060_en.ogg"], ["- \"Locking target!\"", "BbAttackPrimeGrineerMale0070_en.ogg"], ["- \"Terminating!\"", "BbAttackPrimeGrineerMale0080_en.ogg"], ["- \"Take them out!\"", "BbAttackPrimeGrineerMale0090_en.ogg"], ["- \"Formation Delta!\"", "BbAttackPrimeGrineerMale0100_en.ogg"], ["- \"Don't let them escape!\"", "BbAttackPrimeGrineerMale0110_en.ogg"], ["- \"For the Golden Lords!\"", "BbAttackPrimeGrineerMale0120_en.ogg"], ["- \"Open fire, my brothers!\"", "BbAttackPrimeGrineerMale0730_en.ogg"], ["- \"Full force, no quarter!\"", "BbAttackPrimeGrineerMale0740_en.ogg"], ["- \"For the brotherhood!\"", "BbAttackPrimeGrineerMale0750_en.ogg"], ["- \"Annihilate them!\"", "BbAttackPrimeGrineerMale0760_en.ogg"], ["- \"Protect the flanks!\"", "BbAttackPrimeGrineerMale0770_en.ogg"], ["- \"Get at them!\"", "BbAttackPrimeGrineerMale0780_en.ogg"], ["- \"Spread out!\"", "BbAttackPrimeGrineerMale0790_en.ogg"], ["- \"Battle Protocol Delta!\"", "BbAttackPrimeGrineerMale0800_en.ogg"], ["- \"Stand your ground! We are Grineer!\"", "BbAttackPrimeGrineerMale0810_en.ogg"], ["- \"Focus fire!\"", "BbAttackPrimeGrineerMale0820_en.ogg"]]},
