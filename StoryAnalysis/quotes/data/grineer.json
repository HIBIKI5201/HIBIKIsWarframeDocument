  {"path": ["Female Prime Grineer", "Patrol"], "idle": false, "lines": [["- \"We were meant for better than this.\"", "BbPatrolPrimeGrineerFemale0250_en.ogg"], ["- \"You grew us to kill. You better give us something to aim at.\"", "BbPatrolPrimeGrineerFemale0260_en.ogg"], ["- \"Void damn it, brothers. We're not just mine workers anymore. Stop acting so dumb.\"", "BbPatrolPrimeGrineerFemale0270_en.ogg"], ["- \"Got to find myself a Tenno. Pull it apart and see how it works.\"", "BbPatrolPrimeGrineerFemale0280_en.ogg"], ["- \"We might not be as fancy as a Dax, but we're a damn sight more loyal.\"", "BbPatrolPrimeGrineerFemale0290_en.ogg"], ["- \"This mud ball is ours.\"", "BbPatrolPrimeGrineerFemale0300_en.ogg"], ["- \"I swear, some of them could shoot themselves in the foot with a shovel.\"", "BbPatrolPrimeGrineerFemale0310_en.ogg"], ["- \"I hate the waiting.\"", "BbPatrolPrimeGrineerFemale0320_en.ogg"]]},
  {"path": ["Female Prime Grineer", "Enemy Spotted"], "idle": false, "lines": [["- \"I see them!\"", "BbEnemySpottedPrimeGrineerFemale0330_en.ogg"], ["- \"Fresh targets!\"", "BbEnemySpottedPrimeGrineerFemale0340_en.ogg"], ["- \"Heads up!\"", "BbEnemySpottedPrimeGrineerFemale0350_en.ogg"], ["- \"Check your damn scopes!\"", "BbEnemySpottedPrimeGrineerFemale0360_en.ogg"], ["- \"There! Marking them!\"", "BbEnemySpottedPrimeGrineerFemale0370_en.ogg"], ["- \"Found you!\"", "BbEnemySpottedPrimeGrineerFemale0380_en.ogg"], ["- \"Hostiles! Move!\"", "BbEnemySpottedPrimeGrineerFemale0390_en.ogg"], ["- \"Finally! Action!\"", "BbEnemySpottedPrimeGrineerFemale0400_en.ogg"], ["- \"You're mine, scum!\"", "BbEnemySpottedPrimeGrineerFemale0410_en.ogg"], ["- \"Target in sight!\"", "BbEnemySpottedPrimeGrineerFemale0420_en.ogg"], ["- \"Brothers! Sisters! Fire at will!\"", "BbEnemySpottedPrimeGrineerFemale0430_en.ogg"], ["- \"This won't take long!\"", "BbEnemySpottedPrimeGrineerFemale0440_en.ogg"], ["- \"Contact!\"", "BbEnemySpottedPrimeGrineerFemale0450_en.ogg"], ["- \"Heads up, Vat Rats!\"", "BbEnemySpottedPrimeGrineerFemale0460_en.ogg"], ["- \"We got Tenno!\"", "BbEnemySpottedPrimeGrineerFemale0470_en.ogg"], ["- \"Priority targets! Tenno in sights!\"", "BbEnemySpottedPrimeGrineerFemale0480_en.ogg"]]},
  {"path": ["Female Prime Grineer", "Attack"], "idle": false, "lines": [["- \"Locking targets!\"", "BbAttackPrimeGrineerFemale0130_en.ogg"], ["- \"Take them out!\"", "BbAttackPrimeGrineerFemale0140_en.ogg"], ["- \"Formation Delta!\"", "BbAttackPrimeGrineerFemale0150_en.ogg"], ["- \"Terminating!\"", "BbAttackPrimeGrineerFemale0160_en.ogg"], ["- \"Don't let them escape!\"", "BbAttackPrimeGrineerFemale0170_en.ogg"], ["- \"Wipe the scum out!\"", "BbAttackPrimeGrineerFemale0180_en.ogg"], ["- \"Steam up, squad! Let's do this!\"", "BbAttackPrimeGrineerFemale0190_en.ogg"], ["- \"Oh, this will be fun!\"", "BbAttackPrimeGrineerFemale0200_en.ogg"], ["- \"Watch and learn, brothers!\"", "BbAttackPrimeGrineerFemale0210_en.ogg"], ["- \"History will remember us!\"", "BbAttackPrimeGrineerFemale0220_en.ogg"], ["- \"Spearpoint Formation! Now!\"", "BbAttackPrimeGrineerFemale0230_en.ogg"], ["- (battle cry)", "BbAttackPrimeGrineerFemale0240_en.ogg"]]},
